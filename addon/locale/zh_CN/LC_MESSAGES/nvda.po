# Cloud menu and account dialogs.
#. Translators: Title of the Tiantan Clipboard account dialog.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:35
msgid "Tiantan Clipboard"
msgstr "天坦剪贴板"

#. Translators: Label for the current Tiantan Clipboard status.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:53
msgid "Status:"
msgstr "状态："

#. Translators: Description shown in the Tiantan Clipboard dialog.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:61
msgid "Syncs clipboard text between this computer and Tiantan."
msgstr "在本机与天坦之间同步剪贴板文本。"

#. Translators: Label for the ClipDataCloud phone number field.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:70
msgid "&Phone number:"
msgstr "手机号(&P)："

#. Translators: Label for the ClipDataCloud password field.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:76
msgid "Pass&word:"
msgstr "密码(&W)："

#. Translators: Button to log in to ClipDataCloud.
#. Translators: Button to sign in to OneDrive with the system browser.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:82
#: addon\globalPlugins\nvdaClipboard\oneDriveDialog.py:93
msgid "Sign &in"
msgstr "登录(&I)"

#. Translators: Label for the signed-in Tiantan Clipboard account.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:93
msgid "Account:"
msgstr "账户："

#. Translators: Button to log out of ClipDataCloud.
#. Translators: Button to sign out of OneDrive synchronization.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:101
#: addon\globalPlugins\nvdaClipboard\oneDriveDialog.py:141
msgid "Sign &out"
msgstr "退出登录(&O)"

#. Translators: Button to close the Tiantan Clipboard account dialog.
#. Translators: Button to close the OneDrive account dialog.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:113
#: addon\globalPlugins\nvdaClipboard\oneDriveDialog.py:153
msgid "&Close"
msgstr "关闭(&C)"

#. Translators: Progress message while signing in to Tiantan Clipboard.
#. Translators: OneDrive status while the system browser handles Microsoft login.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:180
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1037
msgid "Signing in..."
msgstr "正在登录..."

#. Translators: Progress message while signing out of Tiantan Clipboard.
#. Translators: OneDrive status while cached Microsoft credentials are removed.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:189
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:123
msgid "Signing out..."
msgstr "正在退出..."

#. Translators: Error shown when the native cloud clipboard library cannot be used.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:51
msgid "Tiantan is unavailable. Check ClipDataCloud.SDK.dll."
msgstr "天坦不可用，请检查 ClipDataCloud.SDK.dll。"

#. Translators: Message shown when another cloud account action is still running.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:56
msgid "Another Tiantan account action is in progress"
msgstr "另一个天坦账户操作正在进行"

#. Translators: Initial cloud clipboard status before the persisted login is checked.
#. Translators: OneDrive status while cached Microsoft sign-in is checked.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:89
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:117
msgid "Checking..."
msgstr "正在检查..."

#. Translators: Membership label for a paid cloud clipboard account.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:146
msgid "VIP account"
msgstr "VIP 账户"

#: addon\globalPlugins\nvdaClipboard\cloudSync.py:146
msgid "standard account"
msgstr "普通账户"

#: addon\globalPlugins\nvdaClipboard\cloudSync.py:147
#, python-brace-format
msgid "{nickname}, {memberStatus}"
msgstr "{nickname}，{memberStatus}"

#. Translators: Tiantan account status when signed in without profile details.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:152
msgid "Signed in"
msgstr "已登录"

#. Translators: Cloud clipboard account status when no account is signed in.
#. Translators: Cloud clipboard status when no account is signed in.
#. Translators: Cloud clipboard status reported by the native SDK.
#. Translators: OneDrive account status when no Microsoft account is signed in.
#. Translators: OneDrive status when no cached Microsoft account is usable.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:154
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:224
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:539
#: addon\globalPlugins\nvdaClipboard\oneDriveDialog.py:223
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:119
msgid "Not signed in"
msgstr "未登录"

#. Translators: Validation message in the cloud clipboard login dialog.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:163
msgid "Enter a phone number and password"
msgstr "请输入手机号和密码"

#. Translators: Error prefix for a failed cloud clipboard login.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:176
#, python-brace-format
msgid "Sign-in failed: {error}"
msgstr "登录失败：{error}"

#. Translators: Status shown after signing out of cloud clipboard.
#. Translators: Status after removing the cached Microsoft account.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:196
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1211
msgid "Signed out"
msgstr "已退出"

#. Translators: Error prefix for a failed cloud clipboard logout.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:200
#, python-brace-format
msgid "Sign-out failed: {error}"
msgstr "退出登录失败：{error}"

#. Translators: Error prefix when checking cloud clipboard account status fails.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:228
#, python-brace-format
msgid "Status check failed: {error}"
msgstr "状态检查失败：{error}"

#. Translators: Message shown when a manual Tiantan send is still running.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:253
msgid "Tiantan send is in progress"
msgstr "正在发送到天坦"

#. Translators: Confirmation after manually uploading clipboard text.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:274
msgid "Sent to Tiantan"
msgstr "已发送到天坦"

#: addon\globalPlugins\nvdaClipboard\cloudSync.py:280
#, python-brace-format
msgid "Send failed: {error}"
msgstr "发送失败：{error}"

#. Translators: Error prefix for a failed cloud clipboard fetch.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:297
#, python-brace-format
msgid "Receive failed: {error}"
msgstr "接收失败：{error}"

#. Translators: Message shown when the cloud clipboard contains no text.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:598
msgid "Tiantan clipboard is empty"
msgstr "天坦剪贴板为空"

#. Translators: Error shown when downloaded cloud text cannot be written locally.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:608
#, python-brace-format
msgid "Could not update the clipboard: {error}"
msgstr "无法更新剪贴板：{error}"

#. Translators: Confirmation after downloading text from cloud clipboard.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:612
msgid "Received from Tiantan"
msgstr "已从天坦接收"

#. Translators: Status shown when automatic upload stops because the account signed out.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:690
msgid "Tiantan signed out. Automatic sync stopped."
msgstr "天坦已退出，自动同步已停止。"

#. Translators: Message shown when there is no clipboard text to upload.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:716
msgid "There is no clipboard text to upload"
msgstr "没有可上传的剪贴板文本"

#. Translators: Message shown when clipboard text contains a NUL character.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:719
msgid "Text contains a NUL character and was not uploaded"
msgstr "文本包含 NUL 字符，未能上传"

#. Translators: Message shown when clipboard text exceeds the cloud size limit.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:722
msgid "Text exceeds 1 MB and was not uploaded"
msgstr "文本超过 1 MB，未能上传"

#. Translators: Message shown when clipboard text contains invalid Unicode data.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:725
msgid "Text contains invalid Unicode data and was not uploaded"
msgstr "文本包含无效的 Unicode 数据，未能上传"

#. Translators: Cloud SDK error description.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:734
msgid "Invalid argument"
msgstr "参数无效"

#. Translators: Cloud SDK error description.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:737
msgid "The output buffer is too small"
msgstr "输出缓冲区过小"

#. Translators: Cloud SDK error description.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:740
msgid "The account is not signed in"
msgstr "账户未登录"

#. Translators: Fallback description when the cloud SDK returns no error text.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:742
msgid "Unknown Tiantan error"
msgstr "未知的天坦错误"

#. Translators: Generic cloud SDK error with a numeric error code.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:744
#, python-brace-format
msgid "{message} (error code {code})"
msgstr "{message}（错误代码 {code}）"

#. Translators: Tiantan automatic synchronization status when enabled.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:774
msgid "Auto sync: on"
msgstr "自动同步：开"

#. Translators: Tiantan automatic synchronization status when disabled.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:776
msgid "Auto sync: off"
msgstr "自动同步：关"

#. Translators: Error shown when an add-on window cannot open because NVDA's main window is unavailable.
#: addon\globalPlugins\nvdaClipboard\controller.py:95
msgid "NVDA's main window is unavailable"
msgstr "NVDA 主窗口不可用"

#. Translators: Name of the built-in category containing recent clipboard text.
#: addon\globalPlugins\nvdaClipboard\controller.py:98
msgid "Clipboard history"
msgstr "剪贴板历史"

#. Translators: Exact name of the RGB color (255, 0, 0).
#: addon\globalPlugins\nvdaClipboard\controller.py:103
msgid "red"
msgstr "红色"

#. Translators: Exact name of the RGB color (0, 255, 0).
#: addon\globalPlugins\nvdaClipboard\controller.py:105
msgid "green"
msgstr "绿色"

#. Translators: Exact name of the RGB color (0, 0, 255).
#: addon\globalPlugins\nvdaClipboard\controller.py:107
msgid "blue"
msgstr "蓝色"

#. Translators: Exact name of the RGB color (255, 255, 0).
#: addon\globalPlugins\nvdaClipboard\controller.py:109
msgid "yellow"
msgstr "黄色"

#. Translators: Exact name of the RGB color (0, 255, 255).
#: addon\globalPlugins\nvdaClipboard\controller.py:111
msgid "cyan"
msgstr "青色"

#. Translators: Exact name of the RGB color (255, 0, 255).
#: addon\globalPlugins\nvdaClipboard\controller.py:113
msgid "magenta"
msgstr "品红色"

#. Translators: Error shown when supported clipboard formats cannot be restored.
#: addon\globalPlugins\nvdaClipboard\controller.py:206
#: addon\globalPlugins\nvdaClipboard\controller.py:1055
#: addon\globalPlugins\nvdaClipboard\controller.py:1060
#: addon\globalPlugins\nvdaClipboard\controller.py:1084
#: addon\globalPlugins\nvdaClipboard\controller.py:1967
msgid "Could not write to the system clipboard"
msgstr "无法写入系统剪贴板"

#. Translators: Summary used when the system clipboard is empty.
#: addon\globalPlugins\nvdaClipboard\controller.py:258
#: addon\globalPlugins\nvdaClipboard\controller.py:2367
msgid "Clipboard is empty"
msgstr "剪贴板为空"

#. Translators: Message shown when another Tiantan receive is still running.
#: addon\globalPlugins\nvdaClipboard\controller.py:417
#: addon\globalPlugins\nvdaClipboard\controller.py:460
msgid "A Tiantan receive is already in progress"
msgstr "已有一个天坦接收操作正在进行"

#. Translators: Cloud paste cancellation because keyboard focus could not be identified safely.
#: addon\globalPlugins\nvdaClipboard\controller.py:422
msgid "Keyboard focus could not be identified. Tiantan paste was cancelled."
msgstr "无法确定键盘焦点，已取消天坦粘贴。"

#. Translators: Cloud paste cancellation because focus changed while downloading.
#. Translators: Cloud paste cancellation because focus changed before pasting.
#: addon\globalPlugins\nvdaClipboard\controller.py:430
#: addon\globalPlugins\nvdaClipboard\controller.py:2558
msgid "Focus changed. Tiantan paste was cancelled."
msgstr "焦点已改变，已取消天坦粘贴。"

#. Translators: Number of regular files included in a clipboard size calculation.
#: addon\globalPlugins\nvdaClipboard\controller.py:547
#, python-brace-format
msgid "{count} file"
msgid_plural "{count} files"
msgstr[0] "{count} 个文件"

#. Translators: Number of folders included in a clipboard size calculation.
#: addon\globalPlugins\nvdaClipboard\controller.py:556
#, python-brace-format
msgid "{count} folder"
msgid_plural "{count} folders"
msgstr[0] "{count} 个文件夹"

#. Translators: Separator between file size, file count, and folder count.
#. Translators: Separator between exact clipboard text statistics.
#: addon\globalPlugins\nvdaClipboard\controller.py:561
#: addon\globalPlugins\nvdaClipboard\controller.py:2295
#: addon\globalPlugins\nvdaClipboard\controller.py:2300
msgid ", "
msgstr "，"

#. Translators: Clipboard file calculation with partial size and item counts.
#: addon\globalPlugins\nvdaClipboard\controller.py:565
#, python-brace-format
msgid "{summary}; contents total about {details}"
msgstr "{summary}；内容合计约 {details}"

#. Translators: Completed clipboard file calculation with size and item counts.
#: addon\globalPlugins\nvdaClipboard\controller.py:571
#, python-brace-format
msgid "{summary}; contents total {details}"
msgstr "{summary}；内容合计 {details}"

#. Translators: Clipboard file calculation with size and item counts accumulated so far.
#: addon\globalPlugins\nvdaClipboard\controller.py:577
#, python-brace-format
msgid "{summary}; calculating contents, {details}"
msgstr "{summary}；正在统计内容，当前 {details}"

#. Translators: Clipboard file calculation where no content details were available.
#: addon\globalPlugins\nvdaClipboard\controller.py:584
#, python-brace-format
msgid "{summary}; could not calculate contents"
msgstr "{summary}；无法统计内容"

#. Translators: Clipboard file calculation before any content details are available.
#: addon\globalPlugins\nvdaClipboard\controller.py:587
#, python-brace-format
msgid "{summary}; calculating contents"
msgstr "{summary}；正在统计内容"

#. Translators: Clipboard text type followed by the current one-based navigation line and column.
#: addon\globalPlugins\nvdaClipboard\controller.py:616
#, python-brace-format
msgid "{summary}: line {line}, column {column}"
msgstr "{summary}：{line} 行，{column} 列"

#. Translators: Clipboard text summary with its position while exact statistics are calculated.
#: addon\globalPlugins\nvdaClipboard\controller.py:621
#, python-brace-format
msgid "{summary}; calculating; check again shortly"
msgstr "{summary}；正在计算，请稍后再次查询"

#. Translators: Spoken instead of lengthy text appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:717
#, python-format
msgid "%d character"
msgid_plural "%d characters"
msgstr[0] "%d 个字符"

#. Translators: Announced after text is appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:720
#, python-brace-format
msgid "Appended to clipboard: {text}"
msgstr "已追加 {text} 到剪贴板"

#. Translators: Displayed in braille after text is appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:722
#, python-brace-format
msgid "Appended: {text}"
msgstr "已追加 {text}"

#. Translators: Message shown when another last-spoken paste is still running.
#: addon\globalPlugins\nvdaClipboard\controller.py:708
msgid "A last spoken paste is already in progress"
msgstr "已有一个最后朗读文本的粘贴操作正在进行"

#. Translators: Message shown when append is requested without selected text.
#: addon\globalPlugins\nvdaClipboard\controller.py:722
msgid "No text is selected"
msgstr "未选择文本"

#. Translators: Confirmation after selected text is appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:726
msgid "Selected text appended"
msgstr "已追加所选文本"

#. Translators: Message shown when a screenshot is blocked by screen curtain.
#: addon\globalPlugins\nvdaClipboard\controller.py:732
msgid "Disable screen curtain before taking a screenshot"
msgstr "请先关闭黑屏再进行截屏"

#. Translators: Error shown when a navigator object screenshot cannot be copied.
#: addon\globalPlugins\nvdaClipboard\controller.py:739
#: addon\globalPlugins\nvdaClipboard\controller.py:743
msgid "Could not copy the navigator object image"
msgstr "无法复制导航对象图像"

#. Translators: Error shown when a navigator object screenshot cannot be encoded for history.
#: addon\globalPlugins\nvdaClipboard\controller.py:748
msgid "Could not prepare the navigator object image"
msgstr "无法处理导航对象图像"

#. Translators: Confirmation after a navigator object screenshot is copied.
#: addon\globalPlugins\nvdaClipboard\controller.py:762
msgid "Navigator object image copied to the clipboard"
msgstr "导航对象图像已复制到剪贴板"

#. Translators: Disambiguates a synchronized user category from the built-in history view.
#: addon\globalPlugins\nvdaClipboard\controller.py:806
#, python-brace-format
msgid "{name} (OneDrive category)"
msgstr "{name}（OneDrive 类别）"

#. Translators: Error shown when a draft is saved directly to history.
#: addon\globalPlugins\nvdaClipboard\controller.py:959
msgid "Clipboard history can only be changed through the system clipboard"
msgstr "只能通过系统剪贴板更改剪贴板历史"

#. Translators: Error shown when an empty category entry is requested.
#: addon\globalPlugins\nvdaClipboard\controller.py:962
msgid "An empty entry cannot be saved"
msgstr "无法保存空条目"

#. Translators: Error shown when another application changes the clipboard during a restore.
#. Translators: Error shown when another application changes the clipboard during an append action.
#: addon\globalPlugins\nvdaClipboard\controller.py:1064
#: addon\globalPlugins\nvdaClipboard\controller.py:1075
#: addon\globalPlugins\nvdaClipboard\controller.py:1930
#: addon\globalPlugins\nvdaClipboard\controller.py:1956
#: addon\globalPlugins\nvdaClipboard\controller.py:2018
msgid "The clipboard changed before it could be updated. Try again."
msgstr "剪贴板在更新前发生了变化，请重试。"

#. Translators: Error shown when an item is moved into clipboard history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1097
msgid "Entries cannot be moved into clipboard history"
msgstr "无法将条目移动到剪贴板历史"

#. Translators: Error shown when the current clipboard image cannot be read.
#. Translators: Error shown when an expected clipboard image cannot be read.
#: addon\globalPlugins\nvdaClipboard\controller.py:1153
#: addon\globalPlugins\nvdaClipboard\controller.py:1164
#: addon\globalPlugins\nvdaClipboard\controller.py:1173
msgid "Could not read the clipboard image"
msgstr "无法读取剪贴板图像"

#. Translators: Message shown when no clipboard image is available to save.
#: addon\globalPlugins\nvdaClipboard\controller.py:1156
msgid "There is no clipboard image to save"
msgstr "剪贴板中没有可保存的图像"

#. Translators: Title of the dialog used to save the current clipboard image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1167
msgid "Save clipboard image"
msgstr "保存剪贴板图像"

#. Translators: Error shown when the clipboard image cannot be saved.
#: addon\globalPlugins\nvdaClipboard\controller.py:1170
msgid "Could not save the clipboard image"
msgstr "无法保存剪贴板图像"

#. Translators: Confirmation after saving a clipboard image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1177
msgid "Clipboard image saved"
msgstr "剪贴板图像已保存"

#. Translators: Error shown when a selected history entry has no exportable image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1184
msgid "The selected entry does not contain a saved image"
msgstr "所选条目不包含已保存的图像"

#. Translators: Title of the dialog used to save an image selected in clipboard history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1187
msgid "Save selected image"
msgstr "保存所选图像"

#. Translators: Error shown when a stored clipboard image cannot be saved.
#: addon\globalPlugins\nvdaClipboard\controller.py:1190
msgid "Could not save the selected image"
msgstr "无法保存所选图像"

#. Translators: Error shown when stored PNG image data is invalid.
#: addon\globalPlugins\nvdaClipboard\controller.py:1193
msgid "The saved image data is invalid"
msgstr "保存的图像数据无效"

#. Translators: Confirmation after saving an image selected from clipboard history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1196
msgid "Selected image saved"
msgstr "所选图像已保存"

#. Translators: Message shown when oversized rich formats are omitted from a history entry.
#: addon\globalPlugins\nvdaClipboard\controller.py:1261
msgid "Some text formatting was too large and was not saved in history"
msgstr "部分文本格式数据过大，未保存到历史记录"

#. Translators: Message shown when a clipboard image could not be normalized for history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1329
#: addon\globalPlugins\nvdaClipboard\controller.py:1437
msgid "The image could not be added to clipboard history"
msgstr "无法将图像添加到剪贴板历史"

#. Translators: Error shown when clipboard content changed but history could not be saved.
#: addon\globalPlugins\nvdaClipboard\controller.py:1424
msgid "Clipboard updated, but history could not be saved"
msgstr "剪贴板已更新，但无法保存历史记录"

#: addon\globalPlugins\nvdaClipboard\controller.py:1431
#, python-brace-format
msgid "The image was not added because it exceeds the {limit} MB history limit"
msgstr "图像超过 {limit} MB 的历史记录大小上限，未能添加"

#. Translators: Message shown when an image exceeds the total history storage limit.
#: addon\globalPlugins\nvdaClipboard\controller.py:1440
msgid "The image was not added because image history storage is full"
msgstr "图像历史存储空间已满，未能添加图像"

#. Translators: Message shown when mixed clipboard content is retained as text only.
#: addon\globalPlugins\nvdaClipboard\controller.py:1445
msgid "The text was saved in history, but its image could not be stored"
msgstr "文本已保存到历史记录，但无法保存其中的图像"

#. Translators: Error shown when a last-spoken command has no captured speech text.
#: addon\globalPlugins\nvdaClipboard\controller.py:1566
msgid "No spoken text is available"
msgstr "没有可用的朗读文本"

#. Translators: Error shown when text cannot be appended because the clipboard is busy.
#: addon\globalPlugins\nvdaClipboard\controller.py:1574
msgid "Could not read the current clipboard"
msgstr "无法读取当前剪贴板"

#. Translators: Error shown when last spoken text would replace non-text clipboard content.
#: addon\globalPlugins\nvdaClipboard\controller.py:1590
msgid "Last spoken text can only be appended to an empty or text clipboard"
msgstr "最后朗读的文本只能追加到空剪贴板或文本剪贴板"

#. Translators: Error shown when temporary last-spoken text cannot be prepared for pasting.
#. Translators: Error shown when temporary last-spoken text cannot be written.
#. Translators: Error shown when the last-spoken paste gesture cannot be sent.
#: addon\globalPlugins\nvdaClipboard\controller.py:1628
#: addon\globalPlugins\nvdaClipboard\controller.py:1651
#: addon\globalPlugins\nvdaClipboard\controller.py:1688
#: addon\globalPlugins\nvdaClipboard\controller.py:1702
#: addon\globalPlugins\nvdaClipboard\controller.py:1708
#: addon\globalPlugins\nvdaClipboard\controller.py:1734
msgid "Could not paste the last spoken text"
msgstr "无法粘贴最后朗读的文本"

#. Translators: Message shown when a paste shortcut remains held until timeout.
#: addon\globalPlugins\nvdaClipboard\controller.py:1635
