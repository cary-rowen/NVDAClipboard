#. Translators: Title of the Tiantan Cloud Clipboard account dialog.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:35
msgid "Tiantan Cloud Clipboard"
msgstr "Хмарний буфер обміну Tiantan"

#. Translators: Label for the current Tiantan Cloud Clipboard status.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:55
msgid "Status:"
msgstr "Статус:"

#. Translators: Description shown in the Tiantan Cloud Clipboard dialog.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:63
msgid ""
"Synchronizes clipboard text between this computer and Tiantan Cloud Clipboard."
msgstr ""
"Синхронізує текст із буфера обміну між цим комп’ютером та хмарним буфером "
"обміну Tiantan."

#. Translators: Label for the Tiantan Cloud Clipboard phone number field.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:72
msgid "&Phone number:"
msgstr "&Номер телефону:"

#. Translators: Label for the Tiantan Cloud Clipboard password field.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:78
msgid "Pass&word:"
msgstr "&Пароль:"

#. Translators: Button to log in to Tiantan Cloud Clipboard.
#. Translators: Button to sign in to OneDrive with the system browser.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:84
#: addon\globalPlugins\nvdaClipboard\oneDriveDialog.py:93
msgid "Sign &in"
msgstr "&Увійти"

#. Translators: Label for the signed-in Tiantan Cloud Clipboard account.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:95
msgid "Account:"
msgstr "Обліковий запис:"

#. Translators: Button to log out of Tiantan Cloud Clipboard.
#. Translators: Button to sign out of OneDrive synchronization.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:103
#: addon\globalPlugins\nvdaClipboard\oneDriveDialog.py:141
msgid "Sign &out"
msgstr "&Вийти"

#. Translators: Button to close the Tiantan Cloud Clipboard account dialog.
#. Translators: Button to close the OneDrive account dialog.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:115
#: addon\globalPlugins\nvdaClipboard\oneDriveDialog.py:153
msgid "&Close"
msgstr "&Закрити"

#. Translators: Progress message while signing in to Tiantan Cloud Clipboard.
#. Translators: OneDrive status while the system browser handles Microsoft login.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:182
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1025
msgid "Signing in..."
msgstr "Вхід..."

#. Translators: Progress message while signing out of Tiantan Cloud Clipboard.
#. Translators: OneDrive status while cached Microsoft credentials are removed.
#: addon\globalPlugins\nvdaClipboard\cloudDialog.py:191
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:123
msgid "Signing out..."
msgstr "Вихід..."

#. Translators: Error shown when the native cloud clipboard library cannot be used.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:49
#: addon\globalPlugins\nvdaClipboard\tiantanSupport.py:34
msgid "Tiantan Cloud Clipboard is unavailable. Check the ClipDataCloud SDK."
msgstr "Хмарний буфер обміну Tiantan недоступний. Перевірте SDK ClipDataCloud."

#. Translators: Initial cloud clipboard status before the persisted login is checked.
#. Translators: OneDrive status while cached Microsoft sign-in is checked.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:82
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:117
msgid "Checking..."
msgstr "Перевірка..."

#. Translators: Membership label for a paid cloud clipboard account.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:139
msgid "VIP account"
msgstr "Розширений обліковий запис"

#: addon\globalPlugins\nvdaClipboard\cloudSync.py:139
msgid "standard account"
msgstr "стандартний обліковий запис"

#: addon\globalPlugins\nvdaClipboard\cloudSync.py:140
#, python-brace-format
msgid "{nickname}, {memberStatus}"
msgstr "{nickname}, {memberStatus}"

#. Translators: Tiantan Cloud Clipboard account status when signed in without profile details.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:145
msgid "Signed in"
msgstr "Увійшли"

#. Translators: Tiantan Cloud Clipboard account status when no account is signed in.
#. Translators: Tiantan Cloud Clipboard status when no account is signed in.
#. Translators: Cloud clipboard status reported by the native SDK.
#. Translators: OneDrive account status when no Microsoft account is signed in.
#. Translators: OneDrive status when no cached Microsoft account is usable.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:147
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:217
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:537
#: addon\globalPlugins\nvdaClipboard\oneDriveDialog.py:223
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:119
msgid "Not signed in"
msgstr "Ви не ввійшли"

#. Translators: Validation message in the cloud clipboard login dialog.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:156
msgid "Enter a phone number and password"
msgstr "Введіть номер телефону та пароль"

#. Translators: Error prefix for a failed cloud clipboard login.
#. Translators: Microsoft authentication failure. {error} is a Microsoft description or code.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:169
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:554
#, python-brace-format
msgid "Sign in failed: {error}"
msgstr "Не вдалося ввійти: {error}"

#. Translators: Status shown after signing out of cloud clipboard.
#. Translators: Status after removing the cached Microsoft account.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:189
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1199
msgid "Signed out"
msgstr "Вийшли з облікового запису"

#. Translators: Error prefix for a failed cloud clipboard logout.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:193
#, python-brace-format
msgid "Sign out failed: {error}"
msgstr "Не вдалося вийти: {error}"

#. Translators: Error prefix when checking cloud clipboard account status fails.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:221
#, python-brace-format
msgid "Status check failed: {error}"
msgstr "Перевірка статусу не вдалася: {error}"

#. Translators: Message shown when a manual cloud clipboard send is still running.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:246
msgid "Tiantan Cloud Clipboard send is in progress"
msgstr "Триває надсилання з хмарного буфера обміну Tiantan"

#. Translators: Confirmation after manually sending clipboard text.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:267
msgid "Sent to Tiantan Cloud Clipboard"
msgstr "Надіслано до хмарного буфера обміну Tiantan"

#. Translators: Error prefix for a failed Tiantan cloud clipboard send.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:273
#, python-brace-format
msgid "Send failed: {error}"
msgstr "Не вдалося надіслати: {error}"

#. Translators: Error prefix for a failed Tiantan cloud clipboard receive.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:290
#, python-brace-format
msgid "Receive failed: {error}"
msgstr "Не вдалося отримати: {error}"

#: addon\globalPlugins\nvdaClipboard\cloudSync.py:392
msgid "Another Tiantan Cloud Clipboard account action is in progress"
msgstr ""
"Виконується ще одна дія з обліковим записом хмарного буфера обміну Tiantan"

#. Translators: Message shown when the cloud clipboard contains no text.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:596
msgid "Tiantan Cloud Clipboard is empty"
msgstr "Хмарний буфер обміну Tiantan порожній"

#. Translators: Error shown when downloaded cloud text cannot be written locally.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:606
#, python-brace-format
msgid "Could not update the clipboard: {error}"
msgstr "Не вдалося оновити буфер обміну: {error}"

#. Translators: Confirmation after downloading text from cloud clipboard.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:610
msgid "Received from Tiantan Cloud Clipboard"
msgstr "Отримано з хмарного буфера обміну Tiantan"

#. Translators: Status shown when automatic upload stops because the account signed out.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:688
msgid "Tiantan Cloud Clipboard signed out. Automatic sync stopped."
msgstr ""
"Вихід з хмарного буфера обміну Tiantan. Автоматична синхронізація зупинена."

#. Translators: Message shown when there is no clipboard text to upload.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:714
msgid "There is no clipboard text to send"
msgstr "Немає тексту в буфері обміну для надсилання"

#. Translators: Message shown when clipboard text contains a NUL character.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:717
msgid "Text contains a NUL character and was not sent"
msgstr "Текст містить символ NUL (0) і не був надісланий"

#. Translators: Message shown when clipboard text exceeds the cloud size limit.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:720
msgid "Text exceeds 1 MB and was not sent"
msgstr "Текст перевищує 1 МБ і не був надісланий"

#. Translators: Message shown when clipboard text contains invalid Unicode data.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:723
msgid "Text contains invalid Unicode data and was not sent"
msgstr "Текст містить недійсні дані Unicode та не був надісланий"

#. Translators: Cloud SDK error description.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:732
msgid "Invalid argument"
msgstr "Недійсний аргумент"

#. Translators: Cloud SDK error description.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:735
msgid "The output buffer is too small"
msgstr "Буфер виводу занадто малий"

#. Translators: Cloud SDK error description.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:738
msgid "The account is not signed in"
msgstr "Ви не увійшли в обліковий запис"

#. Translators: Fallback description when the cloud SDK returns no error text.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:740
msgid "Unknown Tiantan Cloud Clipboard error"
msgstr "Невідома помилка хмарного буфера обміну Tiantan"

#. Translators: Generic cloud SDK error with a numeric error code.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:742
#, python-brace-format
msgid "{message} (error code {code})"
msgstr "{message} (код помилки {code})"

#. Translators: Tiantan Cloud Clipboard automatic synchronization status when enabled.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:772
msgid "Auto sync: on"
msgstr "Автоматична синхронізація: увімкнено"

#. Translators: Tiantan Cloud Clipboard automatic synchronization status when disabled.
#: addon\globalPlugins\nvdaClipboard\cloudSync.py:774
msgid "Auto sync: off"
msgstr "Автоматична синхронізація: вимкнено"

#. Translators: Error shown when an add-on window cannot open because NVDA's main window is unavailable.
#: addon\globalPlugins\nvdaClipboard\controller.py:102
msgid "NVDA's main window is unavailable"
msgstr "Головний діалог NVDA недоступний"

#. Translators: Name of the built-in category containing recent clipboard text.
#: addon\globalPlugins\nvdaClipboard\controller.py:105
msgid "Clipboard history"
msgstr "Історія буфера обміну"

#: addon\globalPlugins\nvdaClipboard\controller.py:109
msgid ""
"Tiantan Cloud Clipboard is disabled. Enable it in settings, then restart NVDA."
msgstr ""
"Хмарний буфер обміну Tiantan вимкнено. Увімкніть його в налаштуваннях, а потім "
"перезапустіть NVDA."

#. Translators: Exact name of the RGB color (255, 0, 0).
#: addon\globalPlugins\nvdaClipboard\controller.py:114
msgid "red"
msgstr "червоний"

#. Translators: Exact name of the RGB color (0, 255, 0).
#: addon\globalPlugins\nvdaClipboard\controller.py:116
msgid "green"
msgstr "зелений"

#. Translators: Exact name of the RGB color (0, 0, 255).
#: addon\globalPlugins\nvdaClipboard\controller.py:118
msgid "blue"
msgstr "синій"

#. Translators: Exact name of the RGB color (255, 255, 0).
#: addon\globalPlugins\nvdaClipboard\controller.py:120
msgid "yellow"
msgstr "жовтий"

#. Translators: Exact name of the RGB color (0, 255, 255).
#: addon\globalPlugins\nvdaClipboard\controller.py:122
msgid "cyan"
msgstr "блакитний"

#. Translators: Exact name of the RGB color (255, 0, 255).
#: addon\globalPlugins\nvdaClipboard\controller.py:124
msgid "magenta"
msgstr "пурпуровий"

#. Translators: Presented instead of lengthy text in clipboard feedback.
#: addon\globalPlugins\nvdaClipboard\controller.py:186
#, python-format
msgid "%d character"
msgid_plural "%d characters"
msgstr[0] "%d символ"
msgstr[1] "%d символи"
msgstr[2] "%d символів"

#. Translators: Error shown when supported formats cannot be written to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:350
#: addon\globalPlugins\nvdaClipboard\controller.py:1301
#: addon\globalPlugins\nvdaClipboard\controller.py:1306
#: addon\globalPlugins\nvdaClipboard\controller.py:1330
#: addon\globalPlugins\nvdaClipboard\controller.py:2515
msgid "Could not write to the system clipboard"
msgstr "Не вдалося записати в системний буфер обміну"

#. Translators: Summary used when the system clipboard is empty.
#: addon\globalPlugins\nvdaClipboard\controller.py:413
#: addon\globalPlugins\nvdaClipboard\controller.py:2951
msgid "Clipboard is empty"
msgstr "Буфер обміну порожній"

#. Translators: Message shown when another Tiantan Cloud Clipboard receive is still running.
#: addon\globalPlugins\nvdaClipboard\controller.py:581
#: addon\globalPlugins\nvdaClipboard\controller.py:636
msgid "A Tiantan Cloud Clipboard receive is already in progress"
msgstr "Отримання «Хмарного буфера обміну Tiantan» вже триває"

#: addon\globalPlugins\nvdaClipboard\controller.py:587
msgid ""
"Keyboard focus could not be identified. Tiantan Cloud Clipboard paste was "
"cancelled."
msgstr ""
"Не вдалося визначити фокус клавіатури. Вставлення з хмарного буфера обміну "
"Tiantan було скасовано."

#. Translators: Cloud paste cancellation because focus changed before pasting.
#: addon\globalPlugins\nvdaClipboard\controller.py:597
#: addon\globalPlugins\nvdaClipboard\controller.py:3211
msgid "Focus changed. Tiantan Cloud Clipboard paste was cancelled."
msgstr "Фокус змінено. Вставлення з хмарного буфера обміну Tiantan скасовано."

#. Translators: Error shown when the current clipboard cannot be read for the viewer.
#: addon\globalPlugins\nvdaClipboard\controller.py:707
msgid "Could not read the clipboard content"
msgstr "Не вдалося прочитати вміст буфера обміну"

#. Translators: Title of the browse mode window showing clipboard content.
#: addon\globalPlugins\nvdaClipboard\controller.py:711
msgid "Clipboard content"
msgstr "Вміст буфера обміну"

#. Translators: Number of regular files included in a clipboard size calculation.
#: addon\globalPlugins\nvdaClipboard\controller.py:739
#, python-brace-format
msgid "{count} file"
msgid_plural "{count} files"
msgstr[0] "{count} файл"
msgstr[1] "{count} файли"
msgstr[2] "{count} файлів"

#. Translators: Number of folders included in a clipboard size calculation.
#: addon\globalPlugins\nvdaClipboard\controller.py:748
#, python-brace-format
msgid "{count} folder"
msgid_plural "{count} folders"
msgstr[0] "{count} папка"
msgstr[1] "{count} папки"
msgstr[2] "{count} папок"

#. Translators: Separator between file size, file count, and folder count.
#. Translators: Separator between exact clipboard text statistics.
#: addon\globalPlugins\nvdaClipboard\controller.py:754
#: addon\globalPlugins\nvdaClipboard\controller.py:2892
#: addon\globalPlugins\nvdaClipboard\controller.py:2897
msgid ", "
msgstr ", "

#. Translators: Clipboard file calculation with partial size and item counts.
#: addon\globalPlugins\nvdaClipboard\controller.py:758
#, python-brace-format
msgid "{summary}; contents total about {details}"
msgstr "{summary}; загальний вміст приблизно {details}"

#. Translators: Completed clipboard file calculation with size and item counts.
#: addon\globalPlugins\nvdaClipboard\controller.py:764
#, python-brace-format
msgid "{summary}; contents total {details}"
msgstr "{summary}; загальна кількість вмісту {details}"

#. Translators: Clipboard file calculation with size and item counts accumulated so far.
#: addon\globalPlugins\nvdaClipboard\controller.py:770
#, python-brace-format
msgid "{summary}; calculating contents, {details}"
msgstr "{summary}; обчислення вмісту, {details}"

#. Translators: Clipboard file calculation where no content details were available.
#: addon\globalPlugins\nvdaClipboard\controller.py:777
#, python-brace-format
msgid "{summary}; could not calculate contents"
msgstr "{summary}; не вдалося обчислити вміст"

#. Translators: Clipboard file calculation before any content details are available.
#: addon\globalPlugins\nvdaClipboard\controller.py:780
#, python-brace-format
msgid "{summary}; calculating contents"
msgstr "{summary}; обчислення вмісту"

#. Translators: Clipboard text type followed by the current one-based navigation line and column.
#: addon\globalPlugins\nvdaClipboard\controller.py:802
#, python-brace-format
msgid "{summary}: line {line}, column {column}"
msgstr "{summary}: рядок {line}, стовпець {column}"

#. Translators: Clipboard text summary with its position while exact statistics are calculated.
#: addon\globalPlugins\nvdaClipboard\controller.py:807
#, python-brace-format
msgid "{summary}; calculating; check again shortly"
msgstr "{summary}; виконується обчислення; спробуйте ще раз незабаром"

#. Translators: Indicates the start of clipboard text selected for pasting.
#: addon\globalPlugins\nvdaClipboard\controller.py:889
msgid "Start marked"
msgstr "Початок позначено"

#. Translators: Presented when clipboard selection has no start marker.
#: addon\globalPlugins\nvdaClipboard\controller.py:898
msgid "No start marker set"
msgstr "Початковий маркер не встановлено"

#. Translators: Braille message showing text selected in clipboard navigation.
#: addon\globalPlugins\nvdaClipboard\controller.py:901
#, python-format
msgid "%s selected"
msgstr "Вибрано %s"

#. Translators: Message shown when a command requires selected text.
#. Translators: Message shown when append is requested without selected text.
#: addon\globalPlugins\nvdaClipboard\controller.py:913
#: addon\globalPlugins\nvdaClipboard\controller.py:950
msgid "No text is selected"
msgstr "Текст не вибрано"

#. Translators: Announced after text is appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:936
#, python-brace-format
msgid "Appended to clipboard: {text}"
msgstr "Додано до буфера обміну: {text}"

#. Translators: Displayed in braille after text is appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:938
#, python-brace-format
msgid "Appended: {text}"
msgstr "Додано: {text}"

#. Translators: Confirmation after selected text is appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:954
msgid "Selected text appended"
msgstr "Вибраний текст додано"

#. Translators: Message shown when a screenshot is blocked by screen curtain.
#: addon\globalPlugins\nvdaClipboard\controller.py:962
msgid "Disable screen curtain before taking a screenshot"
msgstr "Вимкніть екранну завісу  перед тим, як робити знімок екрана"

#. Translators: Error shown when a navigator object screenshot cannot be copied.
#: addon\globalPlugins\nvdaClipboard\controller.py:967
#: addon\globalPlugins\nvdaClipboard\controller.py:971
msgid "Could not copy the navigator object image"
msgstr "Не вдалося скопіювати зображення об'єкта навігатора"

#. Translators: Error shown when a navigator object screenshot cannot be encoded for history.
#: addon\globalPlugins\nvdaClipboard\controller.py:976
msgid "Could not prepare the navigator object image"
msgstr "Не вдалося підготувати зображення об'єкта навігатора"

#. Translators: Confirmation after a navigator object screenshot is copied.
#: addon\globalPlugins\nvdaClipboard\controller.py:990
msgid "Navigator object image copied to the clipboard"
msgstr "Зображення об'єкта навігатора скопійовано в буфер обміну"

#. Translators: Disambiguates a synchronized user category from the built-in history view.
#: addon\globalPlugins\nvdaClipboard\controller.py:1066
#, python-brace-format
msgid "{name} (OneDrive category)"
msgstr "{name} (категорія OneDrive)"

#. Translators: Error shown when a draft is saved directly to history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1200
msgid "Clipboard history can only be changed through the system clipboard"
msgstr "Історію буфера обміну можна змінити лише через системний буфер обміну"

#. Translators: Error shown when an empty category entry is requested.
#: addon\globalPlugins\nvdaClipboard\controller.py:1203
msgid "An empty entry cannot be saved"
msgstr "Порожній запис не можна зберегти"

#. Translators: Error shown when another application changes the clipboard before an entry is written.
#. Translators: Error shown when another application changes the clipboard during an append action.
#: addon\globalPlugins\nvdaClipboard\controller.py:1239
#: addon\globalPlugins\nvdaClipboard\controller.py:1310
#: addon\globalPlugins\nvdaClipboard\controller.py:1321
#: addon\globalPlugins\nvdaClipboard\controller.py:2478
#: addon\globalPlugins\nvdaClipboard\controller.py:2504
#: addon\globalPlugins\nvdaClipboard\controller.py:2566
msgid "The clipboard changed before it could be updated. Try again."
msgstr ""
"Буфер обміну змінився до того, як його вдалося оновити. Спробуйте ще раз."

#. Translators: Error shown when an item is moved into clipboard history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1343
msgid "Entries cannot be moved into clipboard history"
msgstr "Записи не можна перемістити в історію буфера обміну"

#. Translators: Error shown when the current clipboard image cannot be read.
#. Translators: Error shown when an expected clipboard image cannot be read.
#: addon\globalPlugins\nvdaClipboard\controller.py:1486
#: addon\globalPlugins\nvdaClipboard\controller.py:1497
#: addon\globalPlugins\nvdaClipboard\controller.py:1506
msgid "Could not read the clipboard image"
msgstr "Не вдалося прочитати зображення з буфера обміну"

#. Translators: Message shown when no clipboard image is available to save.
#: addon\globalPlugins\nvdaClipboard\controller.py:1489
msgid "There is no clipboard image to save"
msgstr "Немає зображення з буфера обміну для збереження"

#. Translators: Title of the dialog used to save the current clipboard image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1500
msgid "Save clipboard image"
msgstr "Зберегти зображення з буфера обміну"

#. Translators: Error shown when the clipboard image cannot be saved.
#: addon\globalPlugins\nvdaClipboard\controller.py:1503
msgid "Could not save the clipboard image"
msgstr "Не вдалося зберегти зображення з буфера обміну"

#. Translators: Confirmation after saving a clipboard image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1510
msgid "Clipboard image saved"
msgstr "Зображення буфера обміну збережено"

#. Translators: Error shown when a selected history entry has no exportable image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1517
msgid "The selected entry does not contain a saved image"
msgstr "Вибраний запис не містить збереженого зображення"

#. Translators: Title of the dialog used to save an image selected in clipboard history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1520
msgid "Save selected image"
msgstr "Зберегти вибране зображення"

#. Translators: Error shown when a stored clipboard image cannot be saved.
#: addon\globalPlugins\nvdaClipboard\controller.py:1523
msgid "Could not save the selected image"
msgstr "Не вдалося зберегти вибране зображення"

#. Translators: Error shown when stored PNG image data is invalid.
#: addon\globalPlugins\nvdaClipboard\controller.py:1526
msgid "The saved image data is invalid"
msgstr "Збережені дані зображення недійсні"

#. Translators: Confirmation after saving an image selected from clipboard history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1529
msgid "Selected image saved"
msgstr "Вибране зображення збережено"

#. Translators: Message shown when oversized rich formats are omitted from a history entry.
#: addon\globalPlugins\nvdaClipboard\controller.py:1605
msgid "Some text formatting was too large and was not saved in history"
msgstr ""
"Деяке форматування тексту було занадто великим і не було збережено в історії"

#. Translators: Message shown when a clipboard image could not be normalized for history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1676
#: addon\globalPlugins\nvdaClipboard\controller.py:1793
msgid "The image could not be added to clipboard history"
msgstr "Не вдалося додати зображення до історії буфера обміну"

#. Translators: Error shown when clipboard content changed but history could not be saved.
#: addon\globalPlugins\nvdaClipboard\controller.py:1780
msgid "Clipboard updated, but history could not be saved"
msgstr "Буфер обміну оновлено, але історію не вдалося зберегти"

#: addon\globalPlugins\nvdaClipboard\controller.py:1787
#, python-brace-format
msgid "The image was not added because it exceeds the {limit} MB history limit"
msgstr "Зображення не додано, оскільки воно перевищує ліміт історії {limit} МБ"

#. Translators: Message shown when an image exceeds the total history storage limit.
#: addon\globalPlugins\nvdaClipboard\controller.py:1796
msgid "The image was not added because image history storage is full"
msgstr "Зображення не додано, оскільки сховище історії зображень переповнене"

#. Translators: Message shown when mixed clipboard content is retained as text only.
#: addon\globalPlugins\nvdaClipboard\controller.py:1802
msgid "The text was saved in history, but its image could not be stored"
msgstr "Текст було збережено в історії, але його зображення не вдалося зберегти"

#. Translators: Error shown when a last-spoken command has no captured speech text.
#: addon\globalPlugins\nvdaClipboard\controller.py:1929
msgid "No spoken text is available"
msgstr "Промовлений текст недоступний"

#. Translators: Error shown when text cannot be appended because the clipboard is busy.
#: addon\globalPlugins\nvdaClipboard\controller.py:1937
msgid "Could not read the current clipboard"
msgstr "Не вдалося прочитати поточний буфер обміну"

#. Translators: Message shown when another temporary clipboard paste is still running.
#: addon\globalPlugins\nvdaClipboard\controller.py:1988
msgid "Pasting is in progress. Please wait."
msgstr "Вставка триває. Зачекайте."

#. Translators: Temporary clipboard paste cancellation because keyboard focus could not be identified.
#: addon\globalPlugins\nvdaClipboard\controller.py:2006
msgid "Keyboard focus could not be identified. Paste cancelled."
msgstr "Не вдалося визначити фокус клавіатури. Вставлення скасовано."

#. Translators: Error shown when clipboard content cannot be prepared for pasting.
#. Translators: Error shown when clipboard content cannot be written for pasting.
#. Translators: Error shown when the temporary clipboard paste gesture cannot be sent.
#: addon\globalPlugins\nvdaClipboard\controller.py:2022
#: addon\globalPlugins\nvdaClipboard\controller.py:2061
#: addon\globalPlugins\nvdaClipboard\controller.py:2067
#: addon\globalPlugins\nvdaClipboard\controller.py:2098
#: addon\globalPlugins\nvdaClipboard\controller.py:2145
#: addon\globalPlugins\nvdaClipboard\controller.py:2217
#: addon\globalPlugins\nvdaClipboard\controller.py:2232
#: addon\globalPlugins\nvdaClipboard\controller.py:2238
#: addon\globalPlugins\nvdaClipboard\controller.py:2270
msgid "Could not paste the content"
msgstr "Не вдалося вставити вміст"

#. Translators: Temporary clipboard paste cancellation because focus changed before pasting.
#: addon\globalPlugins\nvdaClipboard\controller.py:2083
#: addon\globalPlugins\nvdaClipboard\controller.py:2262
msgid "Focus changed. Paste cancelled."
msgstr "Фокус змінено. Вставлення скасовано."

#. Translators: Message shown when a paste shortcut remains held until timeout.
#: addon\globalPlugins\nvdaClipboard\controller.py:2105
msgid "The keyboard shortcut was not released, so the paste was cancelled"
msgstr "Комбінацію клавіш не було відпущено, тому вставку скасовано"

#. Translators: Message shown when a clipboard navigation selection becomes stale before pasting.
#: addon\globalPlugins\nvdaClipboard\controller.py:2115
msgid "The clipboard changed. Paste cancelled."
msgstr "Буфер обміну змінився. Вставлення скасовано."

#. Translators: Error shown when the clipboard keeps changing before a temporary paste.
#: addon\globalPlugins\nvdaClipboard\controller.py:2203
#: addon\globalPlugins\nvdaClipboard\controller.py:2254
msgid "The clipboard kept changing. Paste cancelled."
msgstr "Буфер обміну постійно змінювався. Вставлення скасовано."

#. Translators: Error shown after content was pasted but clipboard restoration could not be scheduled.
#: addon\globalPlugins\nvdaClipboard\controller.py:2283
#: addon\globalPlugins\nvdaClipboard\controller.py:2406
msgid ""
"The content was pasted, but the original clipboard content could not be "
"restored"
msgstr ""
"Вміст було вставлено, але відновити початковий вміст буфера обміну не вдалося"

#. Translators: Error shown when the system clipboard cannot be cleared.
#: addon\globalPlugins\nvdaClipboard\controller.py:2572
msgid "Could not clear the system clipboard"
msgstr "Не вдалося очистити системний буфер обміну"

#. Translators: Confirmation before clearing the system clipboard from an empty editor.
#: addon\globalPlugins\nvdaClipboard\controller.py:2623
msgid "The editor is empty. Clear the system clipboard?"
msgstr "Редактор порожній. Очистити системний буфер обміну?"

#. Translators: Title of the clear clipboard confirmation dialog.
#: addon\globalPlugins\nvdaClipboard\controller.py:2625
msgid "Clear Clipboard"
msgstr "Очистити буфер обміну"

#. Translators: Presented when a clipboard text command is used without clipboard text.
#: addon\globalPlugins\nvdaClipboard\controller.py:2651
msgid "There is no text on the clipboard"
msgstr "У буфері обміну немає тексту"

#. Translators: Message shown when text navigation is attempted on an image.
#: addon\globalPlugins\nvdaClipboard\controller.py:2666
msgid "Image content cannot be browsed as text"
msgstr "Вміст зображення не можна переглядати як текст"

#: addon\globalPlugins\nvdaClipboard\controller.py:2713
#, python-brace-format
msgid "{index}. {summary}"
msgstr "{index}. {summary}"

#. Translators: Category and entry count reported by the global category navigation command.
#: addon\globalPlugins\nvdaClipboard\controller.py:2729
#, python-brace-format
msgid "{category}, {count} entry"
msgid_plural "{category}, {count} entries"
msgstr[0] "{category}, {count} запис"
msgstr[1] "{category}, {count} записи"
msgstr[2] "{category}, {count} записів"

#. Translators: Clipboard list summary when text contains no visible characters.
#: addon\globalPlugins\nvdaClipboard\controller.py:2798
msgid "No visible text"
msgstr "Немає видимого тексту"

#. Translators: Clipboard file summary when additional file names are omitted.
#: addon\globalPlugins\nvdaClipboard\controller.py:2804
#, python-brace-format
msgid "{names}, …"
msgstr "{names}, …"

#. Translators: Concise image metadata used inside clipboard list labels.
#: addon\globalPlugins\nvdaClipboard\controller.py:2809
#, python-brace-format
msgid "{width} by {height} pixels, {size}"
msgstr "{width} на {height} пікселів, {size}"

#: addon\globalPlugins\nvdaClipboard\controller.py:2818
#, python-brace-format
msgid ""
"Image\n"
"Dimensions: {width} by {height} pixels\n"
"Color depth: {depth} bits\n"
"Stored size: {size}"
msgstr ""
"Зображення\n"
"Розміри: {width} на {height} пікселів\n"
"Глибина кольору: {depth} бітів\n"
"Збережений розмір: {size}"

#. Translators: Binary data size in terabytes.
#: addon\globalPlugins\nvdaClipboard\controller.py:2830
#, python-brace-format
msgid "{size:.1f} TB"
msgstr "{size:.1f} ТБ"

#. Translators: Binary data size in gigabytes.
#: addon\globalPlugins\nvdaClipboard\controller.py:2833
#, python-brace-format
msgid "{size:.1f} GB"
msgstr "{size:.1f} ГБ"

#. Translators: Binary data size in megabytes.
#: addon\globalPlugins\nvdaClipboard\controller.py:2836
#, python-brace-format
msgid "{size:.1f} MB"
msgstr "{size:.1f} МБ"

#. Translators: Binary data size in kilobytes.
#: addon\globalPlugins\nvdaClipboard\controller.py:2839
#, python-brace-format
msgid "{size:.1f} KB"
msgstr "{size:.1f} КБ"

#. Translators: Binary data size in bytes.
#: addon\globalPlugins\nvdaClipboard\controller.py:2842
#, python-brace-format
msgid "{count} byte"
msgid_plural "{count} bytes"
msgstr[0] "{count} байт"
msgstr[1] "{count} байти"
msgstr[2] "{count} байтів"

#. Translators: Number of user-perceived Unicode characters including whitespace; line breaks are excluded.
#: addon\globalPlugins\nvdaClipboard\controller.py:2852
#, python-brace-format
msgid "{count} character (including whitespace)"
msgid_plural "{count} characters (including whitespace)"
msgstr[0] "{count} символ (включно з пробілами)"
msgstr[1] "{count} символи (включно з пробілами)"
msgstr[2] "{count} символів (включно з пробілами)"

#. Translators: Number of user-perceived Unicode characters excluding whitespace and line breaks.
#: addon\globalPlugins\nvdaClipboard\controller.py:2858
#, python-brace-format
msgid "{count} character (excluding whitespace)"
msgid_plural "{count} characters (excluding whitespace)"
msgstr[0] "{count} символ (без пробілів)"
msgstr[1] "{count} символи (без пробілів)"
msgstr[2] "{count} символів (без пробілів)"

#. Translators: Number of Han ideographic code points in clipboard text.
#: addon\globalPlugins\nvdaClipboard\controller.py:2868
#, python-brace-format
msgid "{count} Han character"
msgid_plural "{count} Han characters"
msgstr[0] "{count} китайський символ (ієрогліф)"
msgstr[1] "{count} китайські символи (ієрогліф)"
msgstr[2] "{count} китайських символів (ієрогліф)"

#. Translators: Number of Unicode punctuation grapheme clusters in clipboard text.
#: addon\globalPlugins\nvdaClipboard\controller.py:2877
#, python-brace-format
