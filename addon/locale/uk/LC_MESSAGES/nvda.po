#. Translators: Name of the NVDA Clipboard command category in NVDA's Input Gestures dialog.
#. Translators: Title of the NVDA Clipboard settings panel.
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\nvdaClipboard\__init__.py:33
#: addon\globalPlugins\nvdaClipboard\settingsPanel.py:43 buildVars.py:32
msgid "NVDA Clipboard"
msgstr "Буфер обміну NVDA"

#. Translators: Generic error reported when an add-on command fails.
#: addon\globalPlugins\nvdaClipboard\__init__.py:94
msgid "The NVDA Clipboard command failed"
msgstr "Не вдалося виконати команду буфера обміну NVDA"

#. Translators: Input help description for reporting or viewing clipboard content.
#: addon\globalPlugins\nvdaClipboard\__init__.py:99
msgid ""
"Reports the clipboard summary; press twice to view its content in browse mode"
msgstr ""
"Повідомляє зведення буфера обміну; натисніть двічі, щоб переглянути його вміст "
"у режимі огляду"

#. Translators: Input help description for moving to the first clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:112
msgid "Moves to and reports the first clipboard line"
msgstr "Переходить до першого рядка буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving to the last clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:122
msgid "Moves to and reports the last clipboard line"
msgstr "Переходить до останнього рядка буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving to the previous clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:132
msgid "Moves to and reports the previous clipboard line"
msgstr "Переходить до попереднього рядка буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving to the next clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:142
msgid "Moves to and reports the next clipboard line"
msgstr "Переходить до наступного рядка буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving up one page through clipboard lines.
#: addon\globalPlugins\nvdaClipboard\__init__.py:152
msgid "Moves up one page through the clipboard and reports the resulting line"
msgstr ""
"Переміщує на одну сторінку вгору в буфері обміну та повідомляє про відповідний "
"рядок"

#. Translators: Input help description for moving down one page through clipboard lines.
#: addon\globalPlugins\nvdaClipboard\__init__.py:161
msgid "Moves down one page through the clipboard and reports the resulting line"
msgstr ""
"Переміщує на одну сторінку вниз в буфері обміну та повідомляє про відповідний "
"рядок"

#. Translators: Input help description for reporting the current clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:171
msgid ""
"Reports the current clipboard line. Press twice to spell it and three times "
"for character descriptions."
msgstr ""
"Повідомляє поточний рядок буфера обміну. ​​Натисніть двічі, щоб його написати, і "
"тричі, щоб отримати опис символа."

#. Translators: Input help description for moving to the previous clipboard navigation unit.
#: addon\globalPlugins\nvdaClipboard\__init__.py:182
msgid "Moves to and reports the previous clipboard navigation unit"
msgstr ""
"Переходить до попереднього блоку навігації буфера обміну та повідомляє про "
"нього"

#. Translators: Input help description for moving to the next clipboard navigation unit.
#: addon\globalPlugins\nvdaClipboard\__init__.py:192
msgid "Moves to and reports the next clipboard navigation unit"
msgstr ""
"Переходить до наступного блоку навігації буфера обміну та повідомляє про нього"

#. Translators: Input help description for reporting the current clipboard navigation unit.
#: addon\globalPlugins\nvdaClipboard\__init__.py:203
msgid ""
"Reports the current clipboard navigation unit. Press twice to spell it and "
"three times for character descriptions."
msgstr ""
"Повідомляє поточний блок навігації буфера обміну. ​​Натисніть двічі, щоб його "
"написати, і тричі, щоб отримати опис символа."

#. Translators: Input help description for moving to the previous clipboard character.
#: addon\globalPlugins\nvdaClipboard\__init__.py:218
msgid "Moves to and reports the previous clipboard character"
msgstr "Переходить до попереднього символу буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving to the next clipboard character.
#: addon\globalPlugins\nvdaClipboard\__init__.py:228
msgid "Moves to and reports the next clipboard character"
msgstr "Переходить до наступного символу буфера обміну та повідомляє про нього"

#. Translators: Input help description for reporting the current clipboard character.
#: addon\globalPlugins\nvdaClipboard\__init__.py:239
msgid ""
"Reports the current clipboard character. Press twice for a description and "
"three times for its numeric value."
msgstr ""
"Повідомляє поточний символ буфера обміну. ​​Натисніть двічі для опису та тричі "
"для його числового значення."

#. Translators: Input help description for marking the start of clipboard text to paste.
#: addon\globalPlugins\nvdaClipboard\__init__.py:250
msgid "Marks the current clipboard navigation position as the selection start"
msgstr "Позначає поточну позицію навігації буфера обміну як початок вибору"

#: addon\globalPlugins\nvdaClipboard\__init__.py:261
msgid ""
"Marks the current clipboard navigation position as the selection end and "
"selects the text between the two markers"
msgstr ""
"Позначає поточну позицію навігації буфера обміну як кінець вибору та вибирає "
"текст між двома позначеннями"

#: addon\globalPlugins\nvdaClipboard\__init__.py:274
msgid ""
"Pastes the clipboard selection, or the current stored entry if there is no "
"complete selection"
msgstr ""
"Вставляє вибране з буфера обміну або поточний збережений запис, якщо вибір не "
"завершений"

#. Translators: Input help description for opening the clipboard manager.
#: addon\globalPlugins\nvdaClipboard\__init__.py:288
msgid "Opens the Clipboard Manager"
msgstr "Відкриває менеджер буфера обміну"

#. Translators: Input help description for appending selected text to the clipboard.
#: addon\globalPlugins\nvdaClipboard\__init__.py:299
msgid "Appends selected text to the clipboard"
msgstr "Додає вибраний текст до буфера обміну"

#. Translators: Input help description for appending the last spoken text.
#: addon\globalPlugins\nvdaClipboard\__init__.py:310
msgid "Appends the last spoken text to the clipboard"
msgstr "Додає останній промовлений текст до буфера обміну"

#. Translators: Input help description for temporarily pasting the last spoken text.
#: addon\globalPlugins\nvdaClipboard\__init__.py:320
msgid "Pastes the last spoken text"
msgstr "Вставляє останній промовлений текст"

#. Translators: Input help description for manually sending clipboard text to Tiantan Cloud Clipboard.
#: addon\globalPlugins\nvdaClipboard\__init__.py:330
msgid "Sends clipboard text to Tiantan Cloud Clipboard"
msgstr "Надсилає текст з буфера обміну до хмарного буфера обміну Tiantan"

#. Translators: Input help description for receiving and pasting Tiantan Cloud Clipboard text.
#: addon\globalPlugins\nvdaClipboard\__init__.py:338
msgid "Receives and pastes from Tiantan Cloud Clipboard"
msgstr "Отримує та вставляє дані з хмарного буфера обміну Tiantan"

#. Translators: Input help description for copying a navigator object screenshot.
#: addon\globalPlugins\nvdaClipboard\__init__.py:347
msgid "Copies an image of the current navigator object to the clipboard"
msgstr "Копіює зображення поточного об'єкта навігатора в буфер обміну"

#. Translators: Input help description for cycling through categories of stored entries.
#: addon\globalPlugins\nvdaClipboard\__init__.py:357
msgid "Cycles through categories of stored entries"
msgstr "Перемикає між категоріями збережених записів"

#. Translators: Input help description for moving to the next stored entry in the current category.
#: addon\globalPlugins\nvdaClipboard\__init__.py:367
msgid "Moves to the next stored entry in the current category"
msgstr "Переходить до наступного збереженого запису в поточній категорії"

#. Translators: Input help description for moving to the previous stored entry in the current category.
#: addon\globalPlugins\nvdaClipboard\__init__.py:377
msgid "Moves to the previous stored entry in the current category"
msgstr "Переходить до попереднього збереженого запису в поточній категорії"

#. Translators: Input help description for putting the current stored entry on the system clipboard.
#: addon\globalPlugins\nvdaClipboard\__init__.py:387
msgid "Puts the current stored entry on the system clipboard"
msgstr "Копіює поточний збережений запис у системний буфер обміну"

#. Translators: Input help description for saving a clipboard image.
#: addon\globalPlugins\nvdaClipboard\__init__.py:397
msgid "Saves the clipboard image to a file"
msgstr "Зберігає зображення з буфера обміну у файл"

#. Translators: File type filter in the save clipboard image dialog.
#: addon\globalPlugins\nvdaClipboard\clipboard\images.py:105
msgid "PNG images (*.png)|*.png"
msgstr "Зображення PNG (*.png)|*.png"

#. Translators: Error shown when an add-on window cannot open because NVDA's main window is unavailable.
#: addon\globalPlugins\nvdaClipboard\controller.py:121
msgid "NVDA's main window is unavailable"
msgstr "Головний діалог NVDA недоступний"

#. Translators: Name of the built-in category containing recent clipboard text.
#: addon\globalPlugins\nvdaClipboard\controller.py:124
msgid "Clipboard history"
msgstr "Історія буфера обміну"

#: addon\globalPlugins\nvdaClipboard\controller.py:128
msgid ""
"Tiantan Cloud Clipboard is disabled. Enable it in settings, then restart NVDA."
msgstr ""
"Хмарний буфер обміну Tiantan вимкнено. Увімкніть його в налаштуваннях, а потім "
"перезапустіть NVDA."

#. Translators: Summary used when the system clipboard is empty.
#: addon\globalPlugins\nvdaClipboard\controller.py:262
#: addon\globalPlugins\nvdaClipboard\summary\formatting.py:294
msgid "Clipboard is empty"
msgstr "Буфер обміну порожній"

#. Translators: Message shown when another Tiantan Cloud Clipboard receive is still running.
#: addon\globalPlugins\nvdaClipboard\controller.py:425
msgid "A Tiantan Cloud Clipboard receive is already in progress"
msgstr "Отримання «Хмарного буфера обміну Tiantan» вже триває"

#: addon\globalPlugins\nvdaClipboard\controller.py:438
msgid ""
"Keyboard focus could not be identified. Tiantan Cloud Clipboard paste was "
"cancelled."
msgstr ""
"Не вдалося визначити фокус клавіатури. Вставлення з хмарного буфера обміну "
"Tiantan було скасовано."

#. Translators: Cloud paste cancellation because focus changed before pasting.
#: addon\globalPlugins\nvdaClipboard\controller.py:448
#: addon\globalPlugins\nvdaClipboard\controller.py:1975
msgid "Focus changed. Tiantan Cloud Clipboard paste was cancelled."
msgstr "Фокус змінено. Вставлення з хмарного буфера обміну Tiantan скасовано."

#. Translators: Error shown when the current clipboard cannot be read for the viewer.
#: addon\globalPlugins\nvdaClipboard\controller.py:542
msgid "Could not read the clipboard content"
msgstr "Не вдалося прочитати вміст буфера обміну"

#. Translators: Title of the browse mode window showing clipboard content.
#: addon\globalPlugins\nvdaClipboard\controller.py:546
msgid "Clipboard content"
msgstr "Вміст буфера обміну"

#. Translators: Indicates the start of clipboard text selected for pasting.
#: addon\globalPlugins\nvdaClipboard\controller.py:657
msgid "Start marked"
msgstr "Початок позначено"

#. Translators: Presented when clipboard selection has no start marker.
#: addon\globalPlugins\nvdaClipboard\controller.py:666
msgid "No start marker set"
msgstr "Початковий маркер не встановлено"

#. Translators: Braille message showing text selected in clipboard navigation.
#: addon\globalPlugins\nvdaClipboard\controller.py:669
#, python-format
msgid "%s selected"
msgstr "Вибрано %s"

#. Translators: Message shown when a command requires selected text.
#. Translators: Message shown when append is requested without selected text.
#: addon\globalPlugins\nvdaClipboard\controller.py:681
#: addon\globalPlugins\nvdaClipboard\controller.py:717
msgid "No text is selected"
msgstr "Текст не вибрано"

#. Translators: Announced after text is appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:703
#, python-brace-format
msgid "Appended to clipboard: {text}"
msgstr "Додано до буфера обміну: {text}"

#. Translators: Displayed in braille after text is appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:705
#, python-brace-format
msgid "Appended: {text}"
msgstr "Додано: {text}"

#. Translators: Confirmation after selected text is appended to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:721
msgid "Selected text appended"
msgstr "Вибраний текст додано"

#. Translators: Message shown when a screenshot is blocked by screen curtain.
#: addon\globalPlugins\nvdaClipboard\controller.py:729
msgid "Disable screen curtain before taking a screenshot"
msgstr "Вимкніть екранну завісу  перед тим, як робити знімок екрана"

#. Translators: Error shown when a navigator object screenshot cannot be copied.
#: addon\globalPlugins\nvdaClipboard\controller.py:734
#: addon\globalPlugins\nvdaClipboard\controller.py:738
msgid "Could not copy the navigator object image"
msgstr "Не вдалося скопіювати зображення об'єкта навігатора"

#. Translators: Error shown when a navigator object screenshot cannot be encoded for history.
#: addon\globalPlugins\nvdaClipboard\controller.py:743
msgid "Could not prepare the navigator object image"
msgstr "Не вдалося підготувати зображення об'єкта навігатора"

#. Translators: Confirmation after a navigator object screenshot is copied.
#: addon\globalPlugins\nvdaClipboard\controller.py:757
msgid "Navigator object image copied to the clipboard"
msgstr "Зображення об'єкта навігатора скопійовано в буфер обміну"

#. Translators: Disambiguates a synchronized user category from the built-in history view.
#: addon\globalPlugins\nvdaClipboard\controller.py:829
#, python-brace-format
msgid "{name} (OneDrive category)"
msgstr "{name} (категорія OneDrive)"

#. Translators: Error shown when a draft is saved directly to history.
#: addon\globalPlugins\nvdaClipboard\controller.py:941
msgid "Clipboard history can only be changed through the system clipboard"
msgstr "Історію буфера обміну можна змінити лише через системний буфер обміну"

#. Translators: Error shown when an empty category entry is requested.
#: addon\globalPlugins\nvdaClipboard\controller.py:944
msgid "An empty entry cannot be saved"
msgstr "Порожній запис не можна зберегти"

#. Translators: Error shown when another application changes the clipboard before an entry is written.
#. Translators: Error shown when another application changes the clipboard during an append action.
#: addon\globalPlugins\nvdaClipboard\controller.py:974
#: addon\globalPlugins\nvdaClipboard\controller.py:1024
#: addon\globalPlugins\nvdaClipboard\controller.py:1035
#: addon\globalPlugins\nvdaClipboard\controller.py:1434
#: addon\globalPlugins\nvdaClipboard\controller.py:1461
#: addon\globalPlugins\nvdaClipboard\controller.py:1572
msgid "The clipboard changed before it could be updated. Try again."
msgstr ""
"Буфер обміну змінився до того, як його вдалося оновити. Спробуйте ще раз."

#. Translators: Error shown when supported formats cannot be written to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:1015
#: addon\globalPlugins\nvdaClipboard\controller.py:1020
#: addon\globalPlugins\nvdaClipboard\controller.py:1044
#: addon\globalPlugins\nvdaClipboard\controller.py:1476
#: addon\globalPlugins\nvdaClipboard\paste.py:178
msgid "Could not write to the system clipboard"
msgstr "Не вдалося записати в системний буфер обміну"

#. Translators: Error shown when an item is moved into clipboard history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1057
msgid "Entries cannot be moved into clipboard history"
msgstr "Записи не можна перемістити в історію буфера обміну"

#. Translators: Error shown when the current clipboard image cannot be read.
#. Translators: Error shown when an expected clipboard image cannot be read.
#: addon\globalPlugins\nvdaClipboard\controller.py:1184
#: addon\globalPlugins\nvdaClipboard\controller.py:1192
#: addon\globalPlugins\nvdaClipboard\controller.py:1201
msgid "Could not read the clipboard image"
msgstr "Не вдалося прочитати зображення з буфера обміну"

#. Translators: Message shown when no clipboard image is available to save.
#: addon\globalPlugins\nvdaClipboard\controller.py:1187
msgid "There is no clipboard image to save"
msgstr "Немає зображення з буфера обміну для збереження"

#. Translators: Title of the dialog used to save the current clipboard image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1195
msgid "Save clipboard image"
msgstr "Зберегти зображення з буфера обміну"

#. Translators: Error shown when the clipboard image cannot be saved.
#: addon\globalPlugins\nvdaClipboard\controller.py:1198
msgid "Could not save the clipboard image"
msgstr "Не вдалося зберегти зображення з буфера обміну"

#. Translators: Confirmation after saving a clipboard image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1205
msgid "Clipboard image saved"
msgstr "Зображення буфера обміну збережено"

#. Translators: Error shown when a selected history entry has no exportable image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1212
msgid "The selected entry does not contain a saved image"
msgstr "Вибраний запис не містить збереженого зображення"

#. Translators: Title of the dialog used to save an image selected in clipboard history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1215
msgid "Save selected image"
msgstr "Зберегти вибране зображення"

#. Translators: Error shown when a stored clipboard image cannot be saved.
#: addon\globalPlugins\nvdaClipboard\controller.py:1218
msgid "Could not save the selected image"
msgstr "Не вдалося зберегти вибране зображення"

#. Translators: Error shown when stored PNG image data is invalid.
#: addon\globalPlugins\nvdaClipboard\controller.py:1221
msgid "The saved image data is invalid"
msgstr "Збережені дані зображення недійсні"

#. Translators: Confirmation after saving an image selected from clipboard history.
#: addon\globalPlugins\nvdaClipboard\controller.py:1224
msgid "Selected image saved"
msgstr "Вибране зображення збережено"

#. Translators: Message shown when oversized rich formats are omitted from a history entry.
#: addon\globalPlugins\nvdaClipboard\controller.py:1293
msgid "Some text formatting was too large and was not saved in history"
msgstr ""
"Деяке форматування тексту було занадто великим і не було збережено в історії"

#. Translators: Message shown when mixed clipboard content is retained as text only.
#: addon\globalPlugins\nvdaClipboard\controller.py:1330
msgid "The text was saved in history, but its image could not be stored"
msgstr "Текст було збережено в історії, але його зображення не вдалося зберегти"

#. Translators: Error shown when a last-spoken command has no captured speech text.
#: addon\globalPlugins\nvdaClipboard\controller.py:1344
msgid "No spoken text is available"
msgstr "Промовлений текст недоступний"

#. Translators: Error shown when text cannot be appended because the clipboard is busy.
#: addon\globalPlugins\nvdaClipboard\controller.py:1352
msgid "Could not read the current clipboard"
msgstr "Не вдалося прочитати поточний буфер обміну"

#. Translators: Error shown when the system clipboard cannot be cleared.
#: addon\globalPlugins\nvdaClipboard\controller.py:1578
msgid "Could not clear the system clipboard"
msgstr "Не вдалося очистити системний буфер обміну"

#. Translators: Confirmation before clearing the system clipboard from an empty editor.
#: addon\globalPlugins\nvdaClipboard\controller.py:1633
msgid "The editor is empty. Clear the system clipboard?"
msgstr "Редактор порожній. Очистити системний буфер обміну?"

#. Translators: Title of the clear clipboard confirmation dialog.
#: addon\globalPlugins\nvdaClipboard\controller.py:1635
msgid "Clear Clipboard"
msgstr "Очистити буфер обміну"

#. Translators: Presented when a clipboard text command is used without clipboard text.
#: addon\globalPlugins\nvdaClipboard\controller.py:1661
msgid "There is no text on the clipboard"
msgstr "У буфері обміну немає тексту"

#. Translators: Message shown when text navigation is attempted on an image.
#: addon\globalPlugins\nvdaClipboard\controller.py:1676
msgid "Image content cannot be browsed as text"
msgstr "Вміст зображення не можна переглядати як текст"

#: addon\globalPlugins\nvdaClipboard\controller.py:1722
#, python-brace-format
msgid "{index}. {summary}"
msgstr "{index}. {summary}"

#. Translators: Category and entry count reported by the global category navigation command.
#: addon\globalPlugins\nvdaClipboard\controller.py:1738
#, python-brace-format
msgid "{category}, {count} entry"
msgid_plural "{category}, {count} entries"
msgstr[0] "{category}, {count} запис"
msgstr[1] "{category}, {count} записи"
msgstr[2] "{category}, {count} записів"

#. Translators: Error shown when a clipboard category name is empty.
#: addon\globalPlugins\nvdaClipboard\controller.py:1779
msgid "The category name cannot be empty"
msgstr "Назва категорії не може бути порожньою"

#. Translators: Error shown when the built-in history name is used for a category.
#: addon\globalPlugins\nvdaClipboard\controller.py:1782
msgid "That category name is reserved"
msgstr "Ця назва категорії зарезервована"

#. Translators: Error shown when a clipboard category already exists.
#: addon\globalPlugins\nvdaClipboard\controller.py:1785
msgid "A category with that name already exists"
msgstr "Категорія з такою назвою вже існує"

#. Translators: Error shown when a clipboard category no longer exists.
#: addon\globalPlugins\nvdaClipboard\controller.py:1788
msgid "The selected category no longer exists"
