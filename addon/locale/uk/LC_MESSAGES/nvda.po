msgstr "Обліковий запис Microsoft"

#. Translators: Error shown when the Microsoft device sign-in page cannot be opened.
#: addon\globalPlugins\nvdaClipboard\oneDriveDialog.py:320
msgid "Could not open the Microsoft sign-in page"
msgstr "Не вдалося відкрити сторінку входу Microsoft"

#. Translators: Error shown when OneDrive synchronization data fails validation.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:52
msgid "OneDrive synchronization data is invalid"
msgstr "Дані синхронізації OneDrive недійсні"

#. Translators: Error shown when the combined history/category manifest is too large.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:163
msgid "The OneDrive synchronization index exceeds the supported size"
msgstr "Індекс синхронізації OneDrive перевищує підтримуваний розмір"

#. Translators: Error shown when a OneDrive synchronization file is malformed.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:175
msgid "The OneDrive synchronization index is not valid JSON"
msgstr "Індекс синхронізації OneDrive не є дійсним JSON"

#. Translators: Error shown for an unknown OneDrive synchronization schema.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:181
msgid "The OneDrive synchronization index uses an unsupported version"
msgstr "Індекс синхронізації OneDrive використовує непідтримувану версію"

#. Translators: Error shown when one history record cannot fit in the cloud format.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:316
msgid "A clipboard history item exceeds the supported OneDrive size"
msgstr ""
"Елемент історії буфера обміну перевищує максимально допустимий розмір у "
"OneDrive"

#. Translators: Error shown when a OneDrive history item is malformed.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:328
msgid "A OneDrive clipboard history item is not valid JSON"
msgstr "Елемент історії буфера обміну OneDrive не є дійсним JSON"

#. Translators: Error shown for an unknown OneDrive history-item schema.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:333
msgid "A OneDrive clipboard history item uses an unsupported version"
msgstr ""
"Елемент історії буфера обміну OneDrive використовує непідтримувану версію"

#. Translators: Error shown when cloud item content does not match its manifest hash.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:361
msgid "A OneDrive clipboard history item failed its integrity check"
msgstr "Елемент історії буфера обміну OneDrive не пройшов перевірку цілісності"

#. Translators: Error shown when a prohibited clipboard item reaches cloud synchronization.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:373
msgid "A clipboard history item is not permitted for OneDrive synchronization"
msgstr ""
"Елемент історії буфера обміну не допускається для синхронізації з OneDrive"

#. Translators: Error shown when a cloud image fails PNG validation.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:385
msgid "A OneDrive clipboard image is invalid"
msgstr "Зображення буфера обміну OneDrive недійсне"

#. Translators: Error shown when merged OneDrive category images exceed the local limit.
#: addon\globalPlugins\nvdaClipboard\oneDriveProtocol.py:612
msgid "OneDrive image data exceeds the 256 MB storage limit"
msgstr "Обсяг сховища зображень OneDrive перевищує 256 МБ"

#. Translators: Error shown when bundled Microsoft sign-in support cannot load.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:102
msgid "Microsoft sign-in support is unavailable"
msgstr "Підтримка входу в систему Microsoft недоступна"

#. Translators: Error shown when a downloaded OneDrive manifest or item file is too large.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:104
msgid "A OneDrive synchronization file exceeds the supported size"
msgstr "Файл синхронізації OneDrive перевищує підтримуваний розмір"

#. Translators: Error shown when OneDrive returns malformed app-folder file-list data.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:106
msgid "OneDrive returned an invalid file list"
msgstr "OneDrive повернув недійсний список файлів"

#. Translators: Error used when another device changes the OneDrive manifest during synchronization.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:108
msgid "The OneDrive synchronization data changed on another device"
msgstr "Дані синхронізації OneDrive змінилися на іншому пристрої"

#. Translators: Error shown when Microsoft sign-in can no longer authorize OneDrive.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:110
msgid "Sign in expired"
msgstr "Термін дії входу минув"

#. Translators: Generic error shown when Microsoft sign-in fails.
#. Translators: Generic Microsoft authentication failure.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:112
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:558
msgid "Sign in failed"
msgstr "Не вдалося увійти"

#. Translators: Error shown when OneDrive synchronization is requested without signing in.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:114
msgid "Sign in to OneDrive before synchronizing"
msgstr "Увійдіть у OneDrive перед синхронізацією"

#. Translators: OneDrive progress while cloud synchronization metadata is read.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:121
msgid "Reading OneDrive synchronization data..."
msgstr "Читання даних синхронізації OneDrive..."

#. Translators: OneDrive status while synchronization is running or about to start.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:125
msgid "Synchronizing..."
msgstr "Синхронізація..."

#. Translators: Error when Microsoft sign-in succeeded but its encrypted cache could not be saved.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:393
msgid "Could not save Microsoft sign-in data"
msgstr "Не вдалося зберегти дані для входу в Microsoft"

#. Translators: Error shown when Microsoft sign-in did not return a usable account.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:403
msgid "Microsoft sign-in did not return a usable account"
msgstr "Система входу Microsoft не знайшла придатного облікового запису"

#. Translators: Error shown when Microsoft sign-in did not retain an account.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:429
msgid "Microsoft sign-in did not retain the selected account"
msgstr "Система входу Microsoft не зберегла вибраний обліковий запис"

#. Translators: Error when browser-based Microsoft sign-in is not completed in time.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:474
msgid "Microsoft sign-in timed out before it was completed"
msgstr "Час очікування входу в Microsoft минув до завершення"

#. Translators: Error shown when Microsoft device-code sign-in cannot start.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:491
msgid "Microsoft did not provide a device sign-in address"
msgstr "Microsoft не надала адресу для входу на пристрої"

#. Translators: Status after the user cancels Microsoft device-code sign-in.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:515
msgid "Microsoft sign-in was canceled"
msgstr "Вхід у Microsoft скасовано"

#. Translators: Error when locally saved Microsoft sign-in data cannot be removed.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:543
msgid "Could not remove Microsoft sign-in data"
msgstr "Не вдалося видалити дані для входу в Microsoft"

#. Translators: Error shown when OneDrive cannot be reached.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:800
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:844
msgid "Could not connect to OneDrive"
msgstr "Не вдалося підключитися до OneDrive"

#. Translators: Error shown when the Microsoft account denies OneDrive app-folder access.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:869
msgid "Microsoft denied access to the OneDrive application folder"
msgstr "Microsoft заборонив доступ до папки програми OneDrive"

#. Translators: Error shown when a file referenced by the OneDrive manifest is missing.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:872
msgid "OneDrive synchronization data is incomplete"
msgstr "Дані синхронізації OneDrive неповні"

#. Translators: Error shown when Microsoft asks the add-on to reduce request frequency.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:877
msgid "OneDrive is temporarily limiting synchronization requests"
msgstr "OneDrive тимчасово обмежує кількість запитів на синхронізацію"

#. Translators: Error shown when the user's OneDrive has insufficient storage.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:880
msgid "OneDrive does not have enough free storage"
msgstr "OneDrive не має достатньо безкоштовного місця для зберігання"

#. Translators: Generic Microsoft Graph failure. {status} is an HTTP status and {code} a safe code.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:883
#, python-brace-format
msgid "OneDrive request failed ({status}{code})"
msgstr "Запит OneDrive не вдався ({status}{code})"

#. Translators: Generic error when startup OneDrive initialization fails unexpectedly.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:980
msgid "OneDrive setup failed"
msgstr "Не вдалося налаштувати OneDrive"

#. Translators: OneDrive status while Microsoft device-code login is running.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1058
msgid "Waiting for sign-in..."
msgstr "Очікування входу..."

#. Translators: Generic error when OneDrive sign-out fails unexpectedly.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1112
msgid "Sign out failed"
msgstr "Не вдалося вийти"

#. Translators: Confirmation before linking this NVDA configuration to a different account.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1165
#, python-brace-format
msgid ""
"This NVDA configuration is linked to another Microsoft account. Switching to "
"{account} resets its synchronization baseline and merges the current local "
"history and categories with that account's OneDrive. Continue?"
msgstr ""
"Ця конфігурація NVDA пов’язана з іншим обліковим записом Microsoft. Перехід на "
"{account} призведе до скидання базових налаштувань синхронізації та об’єднання "
"поточної локальної історії та категорій із OneDrive цього облікового запису. "
"Продовжити?"

#. Translators: Title of the OneDrive account-switch confirmation.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1170
msgid "Switch OneDrive account"
msgstr "Змінити обліковий запис OneDrive"

#. Translators: Confirmation button that switches the OneDrive account.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1172
msgid "&Switch account"
msgstr "&Змінити обліковий запис"

#. Translators: Status after canceling a OneDrive account switch.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1179
msgid "OneDrive account switch was canceled"
msgstr "Зміна облікового запису OneDrive скасована"

#. Translators: Generic error when OneDrive synchronization fails unexpectedly.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1223
msgid "Synchronization failed"
msgstr "Помилка синхронізації"

#. Translators: Status after a complete OneDrive synchronization succeeds.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1242
msgid "Synchronization complete"
msgstr "Синхронізацію завершено"

#. Translators: OneDrive synchronization phase while the cloud index is committed.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1341
msgid "Saving the OneDrive synchronization index..."
msgstr "Збереження індексу синхронізації OneDrive..."

#. Translators: OneDrive synchronization phase while merged data is saved on this device.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1352
msgid "Saving synchronized data on this device..."
msgstr "Збереження синхронізованих даних на цьому пристрої..."

#. Translators: Error after repeated local or cloud changes prevent a stable synchronization.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1369
msgid "Clipboard or OneDrive data kept changing; try again"
msgstr "Дані буфера обміну або OneDrive постійно змінювалися; спробуйте ще раз"

#. Translators: OneDrive download progress. {current} and {total} are item counts.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1450
#, python-brace-format
msgid "Downloading OneDrive items ({current}/{total})..."
msgstr "Завантаження елементів OneDrive ({current}/{total})..."

#. Translators: Progress while existing files are verified and missing files are uploaded.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1535
#, python-brace-format
msgid "Ensuring OneDrive items are uploaded ({current}/{total})..."
msgstr "Забезпечення завантаження елементів OneDrive ({current}/{total})..."

#. Translators: Progress while old unreferenced OneDrive payload files are removed.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1580
#, python-brace-format
msgid "Cleaning up old OneDrive items ({current}/{total})..."
msgstr "Очищення старих елементів OneDrive ({current}/{total})..."

#. Translators: Error when OneDrive is used before its service starts.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1614
msgid "OneDrive synchronization is not initialized"
msgstr "Синхронізацію OneDrive не ініціалізовано"

#. Translators: Error when another OneDrive action is already running.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1621
msgid "Another OneDrive operation is already in progress"
msgstr "Вже виконується інша операція OneDrive"

#. Translators: Error shown when this clipboard database is linked to another account.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1726
msgid "This clipboard database is linked to another Microsoft account"
msgstr ""
"Ця база даних буфера обміну пов'язана з іншим обліковим записом Microsoft"

#. Translators: Error when downloaded OneDrive images cannot fit in local storage.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1729
msgid "OneDrive image data cannot fit in the 256 MB local storage limit"
msgstr "Дані зображень OneDrive не вміщуються в ліміт локального сховища 256 МБ"

#. Translators: Error when synchronized data cannot be saved locally.
#: addon\globalPlugins\nvdaClipboard\oneDriveSync.py:1734
msgid "Could not update local clipboard storage"
msgstr "Не вдалося оновити локальне сховище буфера обміну"

#. Translators: Title of the NVDA Clipboard settings panel.
#. Translators: Name of the NVDA Clipboard command category in NVDA's Input Gestures dialog.
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\nvdaClipboard\settings.py:43
#: addon\globalPlugins\nvdaClipboard\__init__.py:33 buildVars.py:30
msgid "NVDA Clipboard"
msgstr "Буфер обміну NVDA"

#. Translators: Label for choosing how previous, current, and next navigation units are split.
#: addon\globalPlugins\nvdaClipboard\settings.py:51
msgid "Navigation unit &splitting:"
msgstr "&Розділення навігаційного блоку:"

#. Translators: Split clipboard navigation units using Windows word boundaries.
#: addon\globalPlugins\nvdaClipboard\settings.py:57
msgid "Windows word boundaries"
msgstr "Межі слів у Windows"

#. Translators: Split clipboard navigation units at Unicode punctuation characters.
#: addon\globalPlugins\nvdaClipboard\settings.py:59
msgid "Split at punctuation"
msgstr "Розділення за розділовими знаками"

#. Translators: Checkbox to navigate joined words such as "getWord" as separate units.
#: addon\globalPlugins\nvdaClipboard\settings.py:65
msgid "Split joined words by &capitalization"
msgstr "Розділяти об'єднані слова за допомогою &великої літери"

#. Translators: Checkbox to make each punctuation character a separate clipboard navigation unit.
#: addon\globalPlugins\nvdaClipboard\settings.py:73
msgid "Treat &punctuation as separate navigation units"
msgstr "&Розглядати розділові знаки як окремі одиниці навігації"

#. Translators: Checkbox to show clipboard content without rendering Markdown or HTML.
#: addon\globalPlugins\nvdaClipboard\settings.py:84
msgid "Show clipboard content as plain te&xt in browse mode (do not render)"
msgstr ""
"&Показувати вміст буфера обміну як звичайний текст у режимі огляду (без "
"форматування)"

#. Translators: Checkbox to enable Tiantan Cloud Clipboard after NVDA restarts.
#: addon\globalPlugins\nvdaClipboard\settings.py:95
msgid "Enable &Tiantan Cloud Clipboard (requires restart)"
msgstr "Увімкнути хмарний буфер обміну Tiantan (потрібен перезапуск)"

#. Translators: Note shown under the Tiantan Cloud Clipboard option.
#: addon\globalPlugins\nvdaClipboard\settings.py:107
msgid "Tiantan Cloud Clipboard loads only after NVDA restarts."
msgstr "Хмарний буфер обміну Tiantan завантажується лише після перезапуску NVDA."

#. Translators: Label for the number of clipboard lines moved by the page up and page down commands.
#: addon\globalPlugins\nvdaClipboard\settings.py:119
msgid "&Number of lines to move when paging up or down:"
msgstr ""
"&Кількість рядків для переміщення під час перегортання сторінок вгору або вниз:"

#. Translators: Checkbox to ask before closing the clipboard manager with unsaved edits.
#: addon\globalPlugins\nvdaClipboard\settings.py:131
msgid "Ask before closing with unsaved &edits"
msgstr "&Запитувати перед закриттям із незбереженими редагуваннями"

#. Translators: Message shown after changing Tiantan Cloud Clipboard availability.
#: addon\globalPlugins\nvdaClipboard\settings.py:161
msgid "Tiantan Cloud Clipboard changes require NVDA to restart. Restart now?"
msgstr ""
"Зміни в хмарному буфері обміну Tiantan вимагають перезавантаження NVDA. "
"Перезавантажити зараз?"

#. Translators: Title for the restart prompt after changing Tiantan Cloud Clipboard availability.
#: addon\globalPlugins\nvdaClipboard\settings.py:164
msgid "Restart NVDA"
msgstr "Перезавантажити NVDA"

#. Translators: Error shown when Tiantan Cloud Clipboard is not supported by the current NVDA process bitness.
#: addon\globalPlugins\nvdaClipboard\tiantanSupport.py:32
msgid "Tiantan Cloud Clipboard requires 64-bit NVDA."
msgstr ""
"Для роботи хмарного буфера обміну Tiantan потрібна 64-розрядна версія NVDA."

#. Translators: Generic error reported when an add-on command fails.
#: addon\globalPlugins\nvdaClipboard\__init__.py:94
msgid "The NVDA Clipboard command failed"
msgstr "Не вдалося виконати команду буфера обміну NVDA"

#. Translators: Input help description for reporting or viewing clipboard content.
#: addon\globalPlugins\nvdaClipboard\__init__.py:99
msgid ""
"Reports the clipboard summary; press twice to view its content in browse mode"
msgstr ""
"Повідомляє зведення буфера обміну; натисніть двічі, щоб переглянути його вміст "
"у режимі огляду"

#. Translators: Input help description for moving to the first clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:112
msgid "Moves to and reports the first clipboard line"
msgstr "Переходить до першого рядка буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving to the last clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:122
msgid "Moves to and reports the last clipboard line"
msgstr "Переходить до останнього рядка буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving to the previous clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:132
msgid "Moves to and reports the previous clipboard line"
msgstr "Переходить до попереднього рядка буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving to the next clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:142
msgid "Moves to and reports the next clipboard line"
msgstr "Переходить до наступного рядка буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving up one page through clipboard lines.
#: addon\globalPlugins\nvdaClipboard\__init__.py:152
msgid "Moves up one page through the clipboard and reports the resulting line"
msgstr ""
"Переміщує на одну сторінку вгору в буфері обміну та повідомляє про відповідний "
"рядок"

#. Translators: Input help description for moving down one page through clipboard lines.
#: addon\globalPlugins\nvdaClipboard\__init__.py:161
msgid "Moves down one page through the clipboard and reports the resulting line"
msgstr ""
"Переміщує на одну сторінку вниз в буфері обміну та повідомляє про відповідний "
"рядок"

#. Translators: Input help description for reporting the current clipboard line.
#: addon\globalPlugins\nvdaClipboard\__init__.py:171
msgid ""
"Reports the current clipboard line. Press twice to spell it and three times "
"for character descriptions."
msgstr ""
"Повідомляє поточний рядок буфера обміну. ​​Натисніть двічі, щоб його написати, і "
"тричі, щоб отримати опис символа."

#. Translators: Input help description for moving to the previous clipboard navigation unit.
#: addon\globalPlugins\nvdaClipboard\__init__.py:182
msgid "Moves to and reports the previous clipboard navigation unit"
msgstr ""
"Переходить до попереднього блоку навігації буфера обміну та повідомляє про "
"нього"

#. Translators: Input help description for moving to the next clipboard navigation unit.
#: addon\globalPlugins\nvdaClipboard\__init__.py:192
msgid "Moves to and reports the next clipboard navigation unit"
msgstr ""
"Переходить до наступного блоку навігації буфера обміну та повідомляє про нього"

#. Translators: Input help description for reporting the current clipboard navigation unit.
#: addon\globalPlugins\nvdaClipboard\__init__.py:203
msgid ""
"Reports the current clipboard navigation unit. Press twice to spell it and "
"three times for character descriptions."
msgstr ""
"Повідомляє поточний блок навігації буфера обміну. ​​Натисніть двічі, щоб його "
"написати, і тричі, щоб отримати опис символа."

#. Translators: Input help description for moving to the previous clipboard character.
#: addon\globalPlugins\nvdaClipboard\__init__.py:218
msgid "Moves to and reports the previous clipboard character"
msgstr "Переходить до попереднього символу буфера обміну та повідомляє про нього"

#. Translators: Input help description for moving to the next clipboard character.
#: addon\globalPlugins\nvdaClipboard\__init__.py:228
msgid "Moves to and reports the next clipboard character"
msgstr "Переходить до наступного символу буфера обміну та повідомляє про нього"

#. Translators: Input help description for reporting the current clipboard character.
#: addon\globalPlugins\nvdaClipboard\__init__.py:239
msgid ""
"Reports the current clipboard character. Press twice for a description and "
"three times for its numeric value."
msgstr ""
"Повідомляє поточний символ буфера обміну. ​​Натисніть двічі для опису та тричі "
"для його числового значення."

#. Translators: Input help description for marking the start of clipboard text to paste.
#: addon\globalPlugins\nvdaClipboard\__init__.py:250
msgid "Marks the current clipboard navigation position as the selection start"
msgstr "Позначає поточну позицію навігації буфера обміну як початок вибору"

#: addon\globalPlugins\nvdaClipboard\__init__.py:261
msgid ""
"Marks the current clipboard navigation position as the selection end and "
"selects the text between the two markers"
msgstr ""
"Позначає поточну позицію навігації буфера обміну як кінець вибору та вибирає "
"текст між двома позначеннями"

#: addon\globalPlugins\nvdaClipboard\__init__.py:274
msgid ""
"Pastes the clipboard selection, or the current stored entry if there is no "
"complete selection"
msgstr ""
"Вставляє вибране з буфера обміну або поточний збережений запис, якщо вибір не "
"завершений"

#. Translators: Input help description for opening the clipboard manager.
#: addon\globalPlugins\nvdaClipboard\__init__.py:288
