msgid_plural "{count} punctuation marks"
msgstr[0] "{count} знак пунктуації"
msgstr[1] "{count} знаки пунктуації"
msgstr[2] "{count} знаків пунктуації"

#. Translators: Number of Unicode symbol grapheme clusters in clipboard text.
#: addon\globalPlugins\nvdaClipboard\controller.py:2886
#, python-brace-format
msgid "{count} symbol"
msgid_plural "{count} symbols"
msgstr[0] "{count} символ"
msgstr[1] "{count} символи"
msgstr[2] "{count} символів"

#. Translators: Selected character attributes follow the main, additive text statistics.
#: addon\globalPlugins\nvdaClipboard\controller.py:2895
#, python-brace-format
msgid "{details}; including {attributes}"
msgstr "{details}; включаючи {attributes}"

#. Translators: Total explicit lines and exact statistics after the clipboard type and current position.
#: addon\globalPlugins\nvdaClipboard\controller.py:2901
#, python-brace-format
msgid "{summary}, {count} line in total; {details}"
msgid_plural "{summary}, {count} lines in total; {details}"
msgstr[0] "{summary}, загалом {count} рядок; {details}"
msgstr[1] "{summary}, загалом {count} рядки; {details}"
msgstr[2] "{summary}, загалом {count} рядків; {details}"

#. Translators: Type-only summary of plain text before exact statistics are available.
#. Translators: Kind of stored plain text in the manager.
#: addon\globalPlugins\nvdaClipboard\controller.py:2914
#: addon\globalPlugins\nvdaClipboard\manager.py:1324
msgid "Plain text"
msgstr "Звичайний текст"

#. Translators: Type-only summary of formatted text before exact statistics are available.
#. Translators: Kind of stored formatted text in the manager.
#: addon\globalPlugins\nvdaClipboard\controller.py:2917
#: addon\globalPlugins\nvdaClipboard\manager.py:1327
msgid "Formatted text"
msgstr "Форматований текст"

#. Translators: Type of clipboard content containing both text and an image.
#. Translators: Kind of stored text-and-image content in the manager.
#: addon\globalPlugins\nvdaClipboard\controller.py:2920
#: addon\globalPlugins\nvdaClipboard\manager.py:1330
msgid "Text and image"
msgstr "Текст та зображення"

#. Translators: Number of top-level file system items cut to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:2926
#, python-brace-format
msgid "Cut files: {count} item"
msgid_plural "Cut files: {count} items"
msgstr[0] "Вирізано файли: {count} елемент"
msgstr[1] "Вирізано файли: {count} елементи"
msgstr[2] "Вирізано файли: {count} елементів"

#. Translators: Number of top-level file system items linked from the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:2933
#, python-brace-format
msgid "Linked files: {count} item"
msgid_plural "Linked files: {count} items"
msgstr[0] "Пов’язані файли: {count} елемент"
msgstr[1] "Пов’язані файли: {count} елементи"
msgstr[2] "Пов’язані файли: {count} елементів"

#. Translators: Number of top-level file system items copied to the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:2939
#, python-brace-format
msgid "Copied files: {count} item"
msgid_plural "Copied files: {count} items"
msgstr[0] "Скопійовані файли: {count} елемент"
msgstr[1] "Скопійовані файли: {count} елементи"
msgstr[2] "Скопійовані файли: {count} елементів"

#. Translators: Type of image-only clipboard content.
#: addon\globalPlugins\nvdaClipboard\controller.py:2945
msgid "Image"
msgstr "Зображення"

#. Translators: Summary for clipboard content excluded from monitoring by its source application.
#: addon\globalPlugins\nvdaClipboard\controller.py:2948
msgid "Protected clipboard content is not available"
msgstr "Захищений вміст буфера обміну недоступний"

#. Translators: Summary used for clipboard data this add-on cannot navigate.
#: addon\globalPlugins\nvdaClipboard\controller.py:2953
msgid "Unsupported clipboard content"
msgstr "Непідтримуваний вміст буфера обміну"

#. Translators: Orientation of an image whose width and height are equal.
#: addon\globalPlugins\nvdaClipboard\controller.py:2961
msgid "square"
msgstr "квадрат"

#. Translators: Orientation of an image wider than it is tall.
#: addon\globalPlugins\nvdaClipboard\controller.py:2964
msgid "landscape"
msgstr "альбомна"

#. Translators: Orientation of an image taller than it is wide.
#: addon\globalPlugins\nvdaClipboard\controller.py:2967
msgid "portrait"
msgstr "портретна"

#. Translators: Clipboard image type, dimensions, and orientation.
#: addon\globalPlugins\nvdaClipboard\controller.py:2969
#, python-brace-format
msgid "{summary}: {width} by {height} pixels, {orientation}"
msgstr "{summary}: {width} на {height} пікселів, {orientation}"

#. Translators: Exact image property indicating that every pixel is fully transparent.
#: addon\globalPlugins\nvdaClipboard\controller.py:2977
#, python-brace-format
msgid "{summary}; fully transparent"
msgstr "{summary}; повністю прозорий"

#. Translators: Exact image property indicating that every pixel has the same color.
#: addon\globalPlugins\nvdaClipboard\controller.py:2980
#, python-brace-format
msgid "{summary}; solid {color}"
msgstr "{summary}; однотонний {color}"

#. Translators: Image summary followed by the percentage of fully transparent pixels.
#: addon\globalPlugins\nvdaClipboard\controller.py:2987
#, python-brace-format
msgid "{summary}; fully transparent pixels: {percentage}%"
msgstr "{summary}; повністю прозорі пікселі: {percentage}%"

#. Translators: Image summary followed by the percentage of black or white pixels.
#: addon\globalPlugins\nvdaClipboard\controller.py:2993
#, python-brace-format
msgid "{summary}; {color} pixels: {percentage}%"
msgstr "{summary}; {color} пікселів: {percentage}%"

#. Translators: Confirmation after putting one or multiple files on the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:3006
#, python-brace-format
msgid "{count} file put on the clipboard"
msgid_plural "{count} files put on the clipboard"
msgstr[0] "{count} файл скопійовано в буфер обміну"
msgstr[1] "{count} файли скопійовано в буфер обміну"
msgstr[2] "{count} файлів скопійовано в буфер обміну"

#. Translators: Confirmation after putting an image on the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:3012
msgid "Image put on the clipboard"
msgstr "Зображення скопійовано в буфер обміну"

#. Translators: Confirmation after putting mixed text and image content on the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:3015
msgid "Text and image put on the clipboard"
msgstr "Текст та зображення скопійовано в буфер обміну"

#. Translators: Confirmation after putting plain or formatted text on the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:3017
msgid "Text put on the clipboard"
msgstr "Текст скопійовано в буфер обміну"

#. Translators: Navigable clipboard file entry with name, position, and full path.
#: addon\globalPlugins\nvdaClipboard\controller.py:3025
#, python-brace-format
msgid "{name}, item {index} of {count}, {path}"
msgstr "{name}, елемент {index} із {count}, {path}"

#. Translators: Summary used when a file-list clipboard format contains no paths.
#: addon\globalPlugins\nvdaClipboard\controller.py:3033
msgid "No files in clipboard"
msgstr "У буфері обміну немає файлів"

#. Translators: Error shown when a clipboard category name is empty.
#: addon\globalPlugins\nvdaClipboard\controller.py:3039
msgid "The category name cannot be empty"
msgstr "Назва категорії не може бути порожньою"

#. Translators: Error shown when the built-in history name is used for a category.
#: addon\globalPlugins\nvdaClipboard\controller.py:3042
msgid "That category name is reserved"
msgstr "Ця назва категорії зарезервована"

#. Translators: Error shown when a clipboard category already exists.
#: addon\globalPlugins\nvdaClipboard\controller.py:3045
msgid "A category with that name already exists"
msgstr "Категорія з такою назвою вже існує"

#. Translators: Error shown when a clipboard category no longer exists.
#: addon\globalPlugins\nvdaClipboard\controller.py:3048
msgid "The selected category no longer exists"
msgstr "Вибрана категорія більше не існує"

#. Translators: Error shown when deletion of a non-empty category is attempted.
#: addon\globalPlugins\nvdaClipboard\controller.py:3051
msgid "Delete all entries before deleting this category"
msgstr "Видалити всі записи перед видаленням цієї категорії"

#. Translators: Error shown when a collected image cannot fit in clipboard storage.
#: addon\globalPlugins\nvdaClipboard\controller.py:3054
msgid "The image cannot fit in clipboard history storage"
msgstr "Зображення не поміщається в пам'ять історії буфера обміну"

#. Translators: Error shown when stored clipboard entry data is invalid or missing.
#: addon\globalPlugins\nvdaClipboard\controller.py:3057
msgid "The selected clipboard entry is no longer available"
msgstr "Вибраний запис буфера обміну більше недоступний"

#. Translators: Error shown for an invalid clipboard category operation.
#: addon\globalPlugins\nvdaClipboard\controller.py:3060
msgid "The requested category operation is not valid"
msgstr "Запитана операція з категорією недійсна"

#. Translators: Generic clipboard storage operation error.
#: addon\globalPlugins\nvdaClipboard\controller.py:3062
msgid "Could not update clipboard storage"
msgstr "Не вдалося оновити буфер обміну"

#. Translators: Error shown when current clipboard upload policy cannot be checked.
#: addon\globalPlugins\nvdaClipboard\controller.py:3125
msgid "Could not verify the current clipboard for upload"
msgstr "Не вдалося перевірити поточний буфер обміну для завантаження"

#. Translators: Message shown when an application forbids cloud upload of clipboard content.
#: addon\globalPlugins\nvdaClipboard\controller.py:3130
msgid "The current clipboard content is protected from cloud upload"
msgstr "Поточний вміст буфера обміну захищено від завантаження в хмару"

#. Translators: Cloud paste cancellation because another application changed the clipboard.
#: addon\globalPlugins\nvdaClipboard\controller.py:3215
#: addon\globalPlugins\nvdaClipboard\controller.py:3246
msgid "Clipboard changed. Tiantan Cloud Clipboard paste was cancelled."
msgstr ""
"Буфер обміну змінено. Вставлення в хмарний буфер обміну Tiantan скасовано."

#: addon\globalPlugins\nvdaClipboard\controller.py:3235
msgid ""
"The keyboard shortcut was not released. Tiantan Cloud Clipboard text was left "
"on the clipboard without pasting."
msgstr ""
"Комбінацію клавіш не було активовано. Текст хмарного буфера обміну Tiantan "
"залишився в буфері обміну без вставки."

#. Translators: Confirmation after downloaded cloud text is pasted.
#: addon\globalPlugins\nvdaClipboard\controller.py:3250
msgid "Pasted from Tiantan Cloud Clipboard"
msgstr "Вставлено з хмарного буфера обміну Tiantan"

#. Translators: Error shown when the cloud paste keyboard gesture fails.
#: addon\globalPlugins\nvdaClipboard\controller.py:3254
msgid "Tiantan Cloud Clipboard paste failed"
msgstr "Не вдалося вставити вміст хмарного буфера обміну Tiantan"

#. Translators: File type filter in the save clipboard image dialog.
#: addon\globalPlugins\nvdaClipboard\images.py:111
msgid "PNG images (*.png)|*.png"
msgstr "Зображення PNG (*.png)|*.png"

#. Translators: Accessible description for the clipboard manager entry list.
#: addon\globalPlugins\nvdaClipboard\manager.py:92
msgid "Press Alt+S to search the current category"
msgstr "Натисніть Alt+S, щоб знайти поточну категорію"

#. Translators: Title of the clipboard manager window.
#: addon\globalPlugins\nvdaClipboard\manager.py:103
msgid "Clipboard Manager"
msgstr "Менеджер буфера обміну"

#. Translators: Label for the clipboard category list.
#: addon\globalPlugins\nvdaClipboard\manager.py:183
msgid "&Category:"
